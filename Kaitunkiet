local function GetCurrentSea()
    local placeId = game.PlaceId
    if placeId == 2753915549 or placeId == 8521132937 then
        return 1
    elseif placeId == 4442272183 or placeId == 79091703265656 then
        return 2
    elseif placeId == 7449423635 or placeId == 100117331123089 then
        return 3
    end
    if Workspace:FindFirstChild("Map") then
        if Workspace.Map:FindFirstChild("Dressrosa") or Workspace.Map:FindFirstChild("Cafe") then
            return 2
        elseif Workspace.Map:FindFirstChild("Port Town") or Workspace.Map:FindFirstChild("Castle on the Sea") then
            return 3
        end
    end
    return 1
end

