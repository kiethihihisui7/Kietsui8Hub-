local function DeepCopyTable(src)
    local copy = {}
    for k, v in pairs(src) do
        if type(v) == "table" then
            copy[k] = DeepCopyTable(v)
        else
            copy[k] = v
        end
    end
    return copy
end

local function MergeConfig(target, loaded)
    if type(loaded) ~= "table" then return end
    for k, v in pairs(loaded) do
        if type(v) == "table" and type(target[k]) == "table" then
            MergeConfig(target[k], v)
        elseif target[k] ~= nil then
            target[k] = v
        end
    end
end

local function SaveKaitunConfig(cfg)
    if not cfg or not cfg.AutoSaveConfig then return end
    pcall(function()
        getgenv().KaitunSavedConfig = DeepCopyTable(cfg)
        if type(writefile) == "function" then
            writefile(ConfigFileName, HttpService:JSONEncode(cfg))
        end
    end)
end

local function LoadKaitunConfig(baseCfg)
    local merged = DeepCopyTable(baseCfg)
    if not merged.AutoLoadConfig then return merged end
    pcall(function()
        if type(getgenv().KaitunSavedConfig) == "table" then
            MergeConfig(merged, getgenv().KaitunSavedConfig)
        end
        if type(isfile) == "function" and type(readfile) == "function" and isfile(ConfigFileName) then
            local raw = readfile(ConfigFileName)
            local decoded = HttpService:JSONDecode(raw)
            MergeConfig(merged, decoded)
        end
    end)
    return merged
end

getgenv().KaitunConfig = LoadKaitunConfig(getgenv().KaitunConfig or DefaultConfig)
