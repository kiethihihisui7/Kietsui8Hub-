local function IsDroppedFruit(obj)
    if not obj or not obj:IsA("Tool") then return false end
    if obj:FindFirstChild("Handle") then
        if obj.ToolTip == "Blox Fruit" or obj.Name:lower():find("fruit") then
            return true
        end
        for _, child in ipairs(obj:GetChildren()) do
            if child:IsA("BasePart") and (child.Name:lower():find("fruit") or child:FindFirstChildOfClass("TouchTransmitter")) then
                return true
            end
        end
    end
    return false
end

local function FindNearestDroppedFruit()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local nearestTool = nil
    local nearestHandle = nil
    local shortestDist = math.huge

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if IsDroppedFruit(obj) then
            local handle = obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart")
            if handle then
                local dist = (root.Position - handle.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    nearestTool = obj
                    nearestHandle = handle
                end
            end
        end
    end

    return nearestTool, nearestHandle
end

local function FindNearestChest()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local nearestChest = nil
    local shortestDist = math.huge

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name:lower():find("chest") then
            local touch = obj:FindFirstChildOfClass("TouchTransmitter") or obj:FindFirstChildWhichIsA("BasePart")
            if obj.Transparency < 1 and (touch or obj:IsA("BasePart")) then
                local dist = (root.Position - obj.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    nearestChest = obj
                end
            end
        end
    end

    return nearestChest
end

local function FindActiveBossTarget()
    local currentSea = GetCurrentSea()
    local enemiesFolder = Workspace:FindFirstChild("Enemies")
    for _, bossInfo in ipairs(BossDatabase) do
        if bossInfo.Sea == currentSea then
            if enemiesFolder then
                for _, mob in ipairs(enemiesFolder:GetChildren()) do
                    local mHum = mob:FindFirstChildOfClass("Humanoid")
                    local mRoot = mob:FindFirstChild("HumanoidRootPart")
                    if mob.Name == bossInfo.Name and mHum and mHum.Health > 0 and mRoot then
                        return mob, bossInfo
                    end
                end
            end
        end
    end
    for _, bossInfo in ipairs(BossDatabase) do
        if bossInfo.Sea == currentSea then
            return nil, bossInfo
        end
    end
    return nil, nil
end

local isHoppingServer = false
local function PerformServerHop()
    if isHoppingServer then return end
    isHoppingServer = true
    pcall(function()
        local placeId = game.PlaceId
        local cursor = ""
        local chosenServerId = nil

        for _ = 1, 4 do
            local url = "https://games.roblox.com/v1/games/" .. tostring(placeId) .. "/servers/Public?sortOrder=Asc&limit=100"
            if cursor ~= "" then
                url = url .. "&cursor=" .. cursor
            end
            local raw = game:HttpGet(url)
            local decoded = HttpService:JSONDecode(raw)
            if decoded and decoded.data then
                for _, srv in ipairs(decoded.data) do
                    if tostring(srv.id) ~= tostring(game.JobId) and tonumber(srv.playing) and tonumber(srv.maxPlayers) then
                        if srv.playing < srv.maxPlayers then
                            chosenServerId = srv.id
                            break
                        end
                    end
                end
                if chosenServerId then break end
                cursor = decoded.nextPageCursor or ""
                if cursor == "" then break end
            else
                break
            end
        end

        if chosenServerId then
            TeleportService:TeleportToPlaceInstance(placeId, chosenServerId, LocalPlayer)
        else
            TeleportService:Teleport(placeId, LocalPlayer)
        end
    end)
    task.wait(4)
    isHoppingServer = false
end

