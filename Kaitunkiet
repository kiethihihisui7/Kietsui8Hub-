                    local bossRoot = bossMob.HumanoidRootPart
                    local combatOffset = math.clamp(Config.CombatDistance, 8, 22)
                    local combatPos = bossRoot.CFrame * CFrame.new(0, combatOffset * 0.65, combatOffset * 0.45)
                    TweenToTarget(combatPos)

                    local distToBoss = (root.Position - bossRoot.Position).Magnitude
                    if distToBoss <= combatOffset + 7 then
                        if Config.FruitSuperFast then
                            SuperFastFruitCombat(bossRoot.CFrame)
                        else
                            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
                            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
                        end
                    end
                elseif bossInfo then
                    TweenToTarget(bossInfo.SpawnPos)
                end
            end)
        elseif Config.AutoFarm then
            pcall(function()
                AllocateFruitStat()

                local quest = GetQuestForLevel()
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if not root or not hum or hum.Health <= 0 then return end

                if Config.AutoQuest and not HasActiveQuest() then
                    TweenToTarget(quest.QuestPos)
                    local commF = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
                    if commF then
                        commF:InvokeServer("StartQuest", quest.QuestName, quest.QuestNum)
                    end
                    task.wait(0.2)
                end

                local targetMob = nil
                local enemiesFolder = Workspace:FindFirstChild("Enemies")
                if enemiesFolder then
                    for _, mob in ipairs(enemiesFolder:GetChildren()) do
                        local mHum = mob:FindFirstChildOfClass("Humanoid")
                        local mRoot = mob:FindFirstChild("HumanoidRootPart")
                        if mob.Name == quest.Mob and mHum and mHum.Health > 0 and mRoot then
                            targetMob = mob
                            break
                        end
                    end
                end

                if targetMob and targetMob:FindFirstChild("HumanoidRootPart") then
                    local mobRoot = targetMob.HumanoidRootPart
                    local combatOffset = math.clamp(Config.CombatDistance, 8, 22)
                    local combatPos = mobRoot.CFrame * CFrame.new(0, combatOffset * 0.65, combatOffset * 0.45)
                    TweenToTarget(combatPos)

                    local distToMob = (root.Position - mobRoot.Position).Magnitude
                    if distToMob <= combatOffset + 6 then
                        if Config.FruitSuperFast then
                            SuperFastFruitCombat(mobRoot.CFrame)
                        else
                            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
                            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
                        end
                    end
                else
                    TweenToTarget(quest.MobPos)
                end
            end)
        elseif Config.AutoStatFruit then
            pcall(AllocateFruitStat)
        end
    end
end)

