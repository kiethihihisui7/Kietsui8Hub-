-- ==================== ANTI-AFK & AUTO-REJOIN ON DISCONNECT ====================
local isRejoiningServer = false

local function TriggerAutoRejoin()
    if not Config.AutoRejoin or isRejoiningServer then return end
    isRejoiningServer = true
    task.spawn(function()
        while Config.AutoRejoin do
            pcall(function()
                TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
            end)
            task.wait(2.5)
            pcall(function()
                TeleportService:Teleport(game.PlaceId, LocalPlayer)
            end)
            task.wait(4)
        end
        isRejoiningServer = false
    end)
end

LocalPlayer.Idled:Connect(function()
    if not Config.AntiAFK then return end
    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new())
    end)
end)

GuiService.ErrorMessageChanged:Connect(function(msg)
    if Config.AutoRejoin and msg and msg ~= "" then
        TriggerAutoRejoin()
    end
end)

pcall(function()
    local promptOverlay = CoreGui:FindFirstChild("RobloxPromptGui")
        and CoreGui.RobloxPromptGui:FindFirstChild("promptOverlay")
    if promptOverlay then
        promptOverlay.ChildAdded:Connect(function(child)
            if Config.AutoRejoin and (child.Name == "ErrorPrompt" or child.Name == "DisconnectPrompt") then
                task.wait(1)
                TriggerAutoRejoin()
            end
        end)
    end
end)

