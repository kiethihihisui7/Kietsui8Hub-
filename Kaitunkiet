local activeBodyVelocity = nil
local function TweenToTarget(targetCFrame)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then return end

    if not activeBodyVelocity or not activeBodyVelocity.Parent then
        activeBodyVelocity = Instance.new("BodyVelocity")
        activeBodyVelocity.MaxForce = Vector3.new(1e5, 1e5, 1e5)
        activeBodyVelocity.Velocity = Vector3.zero
        activeBodyVelocity.Parent = root
    end

    local dist = (root.Position - targetCFrame.Position).Magnitude
    if dist <= 4 then
        root.CFrame = targetCFrame
        activeBodyVelocity.Velocity = Vector3.zero
        return
    end

    local speed = 320
    local duration = math.clamp(dist / speed, 0.05, 4)
    local tween = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
    tween:Play()
    local startTime = tick()
    while tween.PlaybackState == Enum.PlaybackState.Playing and (tick() - startTime) < duration do
        if not Config.AutoFarm and not Config.AutoBossFarm and not Config.AutoCollectFruits and not Config.AutoChestFarm then
            tween:Cancel()
            break
        end
        activeBodyVelocity.Velocity = Vector3.zero
        RunService.Heartbeat:Wait()
    end
end

-- ==================== FIXLAG + ẨN NHÀ CỬA & THẾ GIỚI (CHỈ GIỮ NPC & PLAYER) ====================
local hiddenBackup = {}
local function ApplyWorldAndFixLagState()
    local char = LocalPlayer.Character
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Decal") or obj:IsA("Texture") then
            local isPlayerPart = char and obj:IsDescendantOf(char)
            local isOtherPlayer = false
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr.Character and obj:IsDescendantOf(plr.Character) then
                    isOtherPlayer = true
                    break
                end
            end
            local isEnemyModel = false
            local enemiesFolder = Workspace:FindFirstChild("Enemies")
            if enemiesFolder and obj:IsDescendantOf(enemiesFolder) then
                isEnemyModel = true
            end

            if Config.HideWorldAndHouses and not isPlayerPart and not isOtherPlayer and not isEnemyModel then
                if obj:IsA("BasePart") then
                    if hiddenBackup[obj] == nil then
                        hiddenBackup[obj] = {Transparency = obj.Transparency, CanCollide = obj.CanCollide}
                    end
                    obj.Transparency = 1
                    obj.CanCollide = false
                elseif obj:IsA("Decal") or obj:IsA("Texture") then
                    if hiddenBackup[obj] == nil then
                        hiddenBackup[obj] = {Transparency = obj.Transparency}
                    end
                    obj.Transparency = 1
                end
            elseif hiddenBackup[obj] ~= nil then
                pcall(function()
                    if obj:IsA("BasePart") then
                        obj.Transparency = hiddenBackup[obj].Transparency
                        obj.CanCollide = hiddenBackup[obj].CanCollide
                    elseif obj:IsA("Decal") or obj:IsA("Texture") then
                        obj.Transparency = hiddenBackup[obj].Transparency
                    end
                end)
                hiddenBackup[obj] = nil
            end
        end

        if Config.FixLagBoost then
            if obj:IsA("BasePart") then
                pcall(function()
                    obj.Material = Enum.Material.SmoothPlastic
                    obj.Reflectance = 0
                end)
            elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
                pcall(function() obj.Enabled = false end)
            end
        end
    end

    if Config.FixLagBoost then
        pcall(function()
            Lighting.GlobalShadows = false
            Lighting.FogEnd = 9e9
            if Workspace:FindFirstChildOfClass("Terrain") then
                Workspace:FindFirstChildOfClass("Terrain").WaterWaveSize = 0
                Workspace:FindFirstChildOfClass("Terrain").WaterTransparency = 1
            end
        end)
    end
end

