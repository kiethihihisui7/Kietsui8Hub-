local currentTab = "NoKey"
local isMinimized = false
local normalSize = MainFrame.Size
local minimizedSize = UDim2.new(0, 460, 0, 42)

local function clearList()
    for _, child in ipairs(ListFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
end

local function renderScripts()
    clearList()
    local sourceList = (currentTab == "NoKey") and noKeyScripts or keyScripts
    local keyword = string.lower(SearchBox.Text or "")
    local count = 0

    for idx, item in ipairs(sourceList) do
        if keyword == "" or string.find(string.lower(item.Name), keyword, 1, true) then
            count += 1
            local btn = Instance.new("TextButton")
            btn.Name = "ScriptBtn_" .. tostring(idx)
            btn.Size = UDim2.new(1, -6, 0, 34)
            btn.BackgroundColor3 = Color3.fromRGB(38, 42, 56)
            btn.TextColor3 = Color3.fromRGB(235, 240, 250)
            btn.Text = "  " .. item.Name
            btn.TextXAlignment = Enum.TextXAlignment.Left
            btn.Font = Enum.Font.GothamMedium
            btn.TextSize = 13
            btn.LayoutOrder = count
            btn.ZIndex = 12
            btn.Parent = ListFrame

            local btnCorner = Instance.new("UICorner")
            btnCorner.CornerRadius = UDim.new(0, 6)
            btnCorner.Parent = btn

            btn.MouseButton1Click:Connect(function()
                runRemoteScript(item.Name, item.Url, item.BypassCache, item.BeforeRun)
            end)
        end
    end

    task.defer(function()
        ListFrame.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y + 14)
    end)
end

local function setTab(tabName)
    currentTab = tabName
    if tabName == "NoKey" then
        NoKeyTabBtn.BackgroundColor3 = Color3.fromRGB(0, 145, 220)
        NoKeyTabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        KeyTabBtn.BackgroundColor3 = Color3.fromRGB(36, 40, 52)
        KeyTabBtn.TextColor3 = Color3.fromRGB(185, 195, 210)
    else
        KeyTabBtn.BackgroundColor3 = Color3.fromRGB(0, 145, 220)
        KeyTabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        NoKeyTabBtn.BackgroundColor3 = Color3.fromRGB(36, 40, 52)
        NoKeyTabBtn.TextColor3 = Color3.fromRGB(185, 195, 210)
    end
    renderScripts()
end

local function toggleMinimize()
    isMinimized = not isMinimized
    local showBody = not isMinimized

    TabBar.Visible = showBody
    SearchBox.Visible = showBody
    ListFrame.Visible = showBody
    MinimizeBtn.Text = isMinimized and "+" or "-"

    TweenService:Create(
        MainFrame,
        TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { Size = isMinimized and minimizedSize or normalSize }
    ):Play()
end

NoKeyTabBtn.MouseButton1Click:Connect(function()
    setTab("NoKey")
end)

KeyTabBtn.MouseButton1Click:Connect(function()
    setTab("Key")
end)

SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
    renderScripts()
end)

MinimizeBtn.MouseButton1Click:Connect(toggleMinimize)

CloseBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = false
end)

MainToggleBtn.MouseButton1Click:Connect(function()
    if not MainFrame.Visible then
        MainFrame.Visible = true
        if isMinimized then
            toggleMinimize()
        end
    else
        toggleMinimize()
    end
end)

