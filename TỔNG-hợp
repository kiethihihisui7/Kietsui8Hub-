local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer

local function notify(title, text, duration)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = title or "Menu Hub",
            Text = text or "",
            Duration = duration or 4
        })
    end)
end

local function runRemoteScript(name, url, bypassCache, beforeRun)
    task.spawn(function()
        notify("Đang tải...", name, 3)

        if typeof(beforeRun) == "function" then
            local okBefore, errBefore = pcall(beforeRun)
            if not okBefore then
                warn("[BeforeRun Error] " .. tostring(name) .. ": " .. tostring(errBefore))
                notify("Lỗi BeforeRun", tostring(errBefore), 5)
                return
            end
        end

        local finalUrl = url
        if bypassCache then
            local sep = string.find(url, "?", 1, true) and "&" or "?"
            finalUrl = url .. sep .. "cb=" .. tostring(os.clock()) .. "_" .. tostring(math.random(1000, 9999))
        end

        local okFetch, sourceOrErr = pcall(function()
            return game:HttpGet(finalUrl, true)
        end)

        if not okFetch or not sourceOrErr or sourceOrErr == "" then
            warn("[HttpGet Error] " .. tostring(name) .. ": " .. tostring(sourceOrErr))
            notify("Không tải được script", name, 5)
            return
        end

        local fn, loadErr = loadstring(sourceOrErr)
        if not fn then
            warn("[Loadstring Error] " .. tostring(name) .. ": " .. tostring(loadErr))
            notify("Lỗi biên dịch script", name, 5)
            return
        end

        local okExec, execErr = pcall(fn)
        if not okExec then
            warn("[Runtime Error] " .. tostring(name) .. ": " .. tostring(execErr))
            notify("Lỗi khi chạy script", name, 5)
            return
        end

        notify("Thành công", "Đã chạy: " .. tostring(name), 3)
    end)
end

