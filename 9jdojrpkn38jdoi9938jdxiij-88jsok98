-- Thông báo trượt xuống từ trên cùng màn hình, tự đóng sau vài giây,
-- chạm vào là đóng ngay. Tôn trọng công tắc Cài Đặt → "Hiển Thị Thông Báo".
----------------------------------------------------------------
task.spawn(function()
	local WELCOME_TITLE = "Chào mừng, %s!" -- %s = tên hiển thị của người chơi
	local WELCOME_TEXT = "Vu Dong Script đã sẵn sàng. Chúc bạn chơi game vui vẻ!"
	local WELCOME_TIME = 4 -- số giây hiện thông báo
	local WELCOME_EVERY_OPEN = false -- true = hiện lại mỗi lần mở menu (false = chỉ hiện 1 lần lúc vào)

	local TOAST_W, TOAST_H = 420, 104
	local toast = nil -- thông báo đang hiện

	-- tên người chơi có thể chứa ký tự < > & nên phải thoát trước khi dùng RichText
	local function escape(s)
		return (s:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
	end

	local function dismiss(t)
		if toast ~= t or not t.Parent then return end
		toast = nil
		local tw = TweenService:Create(t, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = UDim2.new(0.5, 0, 0, -(TOAST_H + 30)),
		})
		tw.Completed:Connect(function() t:Destroy() end)
		tw:Play()
	end

	local function notify(title, text, seconds)
		if State["Hiển Thị Thông Báo"] == false then return end
		seconds = seconds or 4
		if toast then toast:Destroy() toast = nil end -- thông báo mới thay thông báo cũ

		local t = new("Frame", {
			Name = "VuDongToast", AnchorPoint = Vector2.new(0.5, 0), ZIndex = 100,
			Position = UDim2.new(0.5, 0, 0, -(TOAST_H + 30)),
			Size = UDim2.fromOffset(TOAST_W, TOAST_H),
			BackgroundColor3 = Color3.fromRGB(11, 22, 54),
		}, gui)
		toast = t
		corner(t, 22)
		rainbowStroke(t, 3)
		-- màn hình hẹp (điện thoại dọc) thì thu nhỏ cho vừa
		new("UIScale", { Scale = math.clamp((gui.AbsoluteSize.X - 24) / TOAST_W, 0.5, 1) }, t)

		label(t, { Text = "👑", TextSize = 38, Font = F_BOLD, TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(10, 0), Size = UDim2.fromOffset(70, TOAST_H - 8) }, true)
		label(t, { RichText = true, TextSize = 23, Font = F_BOLD, TextTruncate = Enum.TextTruncate.AtEnd,
			Text = '<font color="#' .. theme.accent2:ToHex() .. '">' .. escape(title) .. "</font>",
			Position = UDim2.fromOffset(84, 12), Size = UDim2.new(1, -98, 0, 30) }, true)
		label(t, { Text = text, TextSize = 17, TextColor3 = MUTED, TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			Position = UDim2.fromOffset(84, 44), Size = UDim2.new(1, -98, 0, 46) }, true)

		-- thanh thời gian chạy ngắn dần ở đáy
		local bar = new("Frame", {
			BackgroundColor3 = theme.accent, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 16, 1, -8), Size = UDim2.new(1, -32, 0, 4),
		}, t)
		corner(bar, 2)

		-- chạm vào thông báo để đóng ngay
		new("TextButton", { Text = "", BackgroundTransparency = 1, ZIndex = 101, Size = UDim2.fromScale(1, 1) }, t)
			.Activated:Connect(function() dismiss(t) end)

		TweenService:Create(t, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Position = UDim2.new(0.5, 0, 0, 20),
		}):Play()
		TweenService:Create(bar, TweenInfo.new(seconds, Enum.EasingStyle.Linear), {
			Size = UDim2.new(0, 0, 0, 4),
		}):Play()
		task.delay(seconds, function() dismiss(t) end)
	end

	local function welcome()
		notify(WELCOME_TITLE:format(player.DisplayName), WELCOME_TEXT, WELCOME_TIME)
	end

	if WELCOME_EVERY_OPEN then
		main:GetPropertyChangedSignal("Visible"):Connect(function()
			if main.Visible then welcome() end
		end)
	end

	task.wait(0.4) -- chờ menu hiện ra rồi mới trượt thông báo xuống
	welcome()
end)

