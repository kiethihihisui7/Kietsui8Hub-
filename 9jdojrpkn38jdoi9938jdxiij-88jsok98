-- CHỮ 7 MÀU NHẤP NHÁY CHO TOÀN BỘ MENU
-- Mọi chữ trong menu (tên tab, tiêu đề, nút, hàng chức năng, bảng kết quả quét, thông báo...)
-- đổi qua 7 màu cầu vồng: đỏ, cam, vàng, lục, lam, chàm, tím - nhấp nháy liên tục.
-- Bật / tắt ở: Cài Đặt → "Chữ 7 Màu Nhấp Nháy". Tắt thì mọi chữ trở lại màu gốc.
-- Chỉnh tốc độ / kiểu ngay bên dưới: TEXT_STEP, TEXT_WAVE, TEXT_COLORS.
-- Đặt trong một hàm riêng (task.spawn) để KHÔNG tốn thêm biến local cấp ngoài (Luau giới hạn 200, file này đã gần chạm mức đó).
----------------------------------------------------------------
task.spawn(function()
	local TEXT_STEP = 0.25 -- giây giữa mỗi lần đổi màu (nhỏ hơn = nhấp nháy nhanh hơn)
	local TEXT_WAVE = true -- true: mỗi chữ lệch nhau 1 màu (cầu vồng chạy) | false: cả menu cùng đổi màu một lúc
	local TEXT_STROKE = 0.5 -- viền đen mỏng quanh chữ cho dễ đọc trên mọi màu (1 = không viền)
	local TEXT_NAME = "Chữ 7 Màu Nhấp Nháy"
	local TEXT_COLORS = {
		Color3.fromRGB(255, 70, 70), -- đỏ
		Color3.fromRGB(255, 165, 50), -- cam
		Color3.fromRGB(255, 235, 60), -- vàng
		Color3.fromRGB(70, 240, 110), -- lục
		Color3.fromRGB(60, 220, 255), -- lam
		Color3.fromRGB(110, 150, 255), -- chàm
		Color3.fromRGB(205, 115, 255), -- tím
	}

	-- R.objs[chữ] = { idx = thứ tự, inMain = nằm trong menu chính, color / text / stroke... = giá trị gốc để trả lại khi tắt }
	local R = { on = false, step = 0, n = 0, objs = setmetatable({}, { __mode = "k" }), stash = {} }

	-- bỏ màu cố định trong chữ có định dạng, vd <font color="#38d4ff">Script</font> → Script
	local function stripColor(t)
		return (string.gsub(t, '<font color="[^"]*">(.-)</font>', "%1"))
	end

	local function applyStyle(o, rec)
		if rec.stroke >= 1 and TEXT_STROKE < 1 then
			o.TextStrokeColor3 = Color3.new(0, 0, 0)
			o.TextStrokeTransparency = TEXT_STROKE
		end
		if o.RichText and string.find(o.Text, "<font color=", 1, true) then
			rec.text = o.Text
			rec.stripped = stripColor(o.Text)
			o.Text = rec.stripped
		end
	end

	-- đổi màu tất cả chữ sang màu của lượt này
	local function tick()
		R.step += 1
		local menuOn = main.Visible
		local nC = #TEXT_COLORS
		for o, rec in pairs(R.objs) do
			if o.Parent and (menuOn or not rec.inMain) then
				o.TextColor3 = TEXT_COLORS[((TEXT_WAVE and rec.idx or 0) + R.step) % nC + 1]
			end
		end
	end

	local function register(o)
		if R.objs[o] then return end
		if not (o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox")) then return end
		if o:FindFirstAncestorWhichIsA("BillboardGui") then return end
		R.n += 1
		local rec = {
			idx = R.n, inMain = o:IsDescendantOf(main), color = o.TextColor3, text = o.Text,
			stroke = o.TextStrokeTransparency, strokeColor = o.TextStrokeColor3,
		}
		R.objs[o] = rec
		-- chữ đổi nội dung (trạng thái, kết quả quét...): giữ bản gốc để trả lại khi tắt, bản đang hiện thì bỏ màu cố định
		o:GetPropertyChangedSignal("Text"):Connect(function()
			local t = o.Text
			if t == rec.stripped then return end
			rec.text = t
			rec.stripped = nil
			if R.on and o.RichText and string.find(t, "<font color=", 1, true) then
				rec.stripped = stripColor(t)
				o.Text = rec.stripped
			end
		end)
		if R.on then applyStyle(o, rec) end
	end

	local function setOn(on)
		R.on = on
		if on then
			-- chữ nhấp nháy riêng của trang Thông Tin được giao lại cho hệ thống chung này
			for i = #blinkTargets, 1, -1 do
				if blinkTargets[i][2] == "TextColor3" then
					table.insert(R.stash, table.remove(blinkTargets, i))
				end
			end
			for o, rec in pairs(R.objs) do
				if o.Parent then
					rec.color, rec.text, rec.stripped = o.TextColor3, o.Text, nil
					applyStyle(o, rec)
				end
			end
			tick()
		else
			for o, rec in pairs(R.objs) do
				if o.Parent then
					o.TextColor3 = rec.color
					o.TextStrokeTransparency, o.TextStrokeColor3 = rec.stroke, rec.strokeColor
					if rec.stripped then
						o.Text = rec.text
						rec.stripped = nil
					end
				end
			end
			for _, e in ipairs(R.stash) do table.insert(blinkTargets, e) end
			table.clear(R.stash)
			for _, fn in ipairs(themeFns) do pcall(fn) end -- tô lại các chữ theo màu giao diện
		end
	end

	-- công tắc trong Cài Đặt
	toggle(setCard, 6, "🌈", TEXT_NAME, true, "Cài Đặt")
	Callbacks[TEXT_NAME] = function(on) setOn(on) end

	for _, d in ipairs(gui:GetDescendants()) do register(d) end
	gui.DescendantAdded:Connect(register) -- chữ tạo thêm về sau (thông báo, kết quả...) cũng tự nhấp nháy

	setOn(State[TEXT_NAME] ~= false)
	task.spawn(function()
		while gui.Parent do
			if R.on then tick() end
			task.wait(TEXT_STEP)
		end
	end)
end) -- hết khối Chữ 7 Màu Nhấp Nháy
