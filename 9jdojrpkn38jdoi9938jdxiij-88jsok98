			if hum.FloorMaterial ~= Enum.Material.Air and root.AssemblyLinearVelocity.Magnitude < 2 then break end
			task.wait(0.25)
		end
		task.wait(PLOT_SAVE_DELAY)
		if plotHome then return end -- bạn đã bấm lưu tay trong lúc chờ
		local c = player.Character
