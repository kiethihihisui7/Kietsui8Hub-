local LOG_COLORS = {
	[Enum.MessageType.MessageError] = "#ff6b6b",
	[Enum.MessageType.MessageWarning] = "#ffd166",
	[Enum.MessageType.MessageInfo] = "#6ee7ff",
}
logLabel.Text = LOG_IDLE

local logDirty = false
local function renderLog()
	logDirty = false
	if #logLines == 0 then
		logLabel.Text = LOG_IDLE
		return
	end
	local out = {}
	for i = math.max(1, #logLines - LOG_SHOW + 1), #logLines do
		local l = logLines[i]
		table.insert(out, string.format('<font color="%s">%s</font>', l.color, esc(l.text)))
	end
	logLabel.Text = table.concat(out, "\n")
end

local function addLog(text, mtype)
	text = tostring(text)
	local cut = utf8.offset(text, 221)
	if cut then text = text:sub(1, cut - 1) .. "…" end
	table.insert(logLines, { text = os.date("%H:%M:%S") .. "  " .. text, color = LOG_COLORS[mtype] or "#cdd9f5" })
	if #logLines > LOG_MAX then table.remove(logLines, 1) end
	if not logDirty then
		logDirty = true
		task.defer(renderLog)
	end
end

Callbacks["Ghi Log Console"] = function(on)
	logOn = on
	if logConn then
		logConn:Disconnect()
		logConn = nil
	end
	if not on then return end
	table.clear(logLines)
	pcall(function()
		local hist = LogService:GetLogHistory()
		for i = math.max(1, #hist - 10), #hist do
			addLog(hist[i].message, hist[i].messageType)
		end
	end)
	logConn = LogService.MessageOut:Connect(addLog)
	renderLog()
end

-- phần 3: nút tiện ích
-- Thử lần lượt nhiều tên hàm clipboard của các executor (setclipboard / toclipboard / ...).
-- Executor không có hàm nào: tự lưu ra file VuDong_Copy.txt + in ra console (F9) để vẫn lấy được nội dung.
-- Trả về true nếu đã vào clipboard.
local function copyText(txt, okMsg)
	local tries = {
		function() setclipboard(txt) end,
		function() toclipboard(txt) end,
		function() set_clipboard(txt) end,
		function() setrbxclipboard(txt) end,
		function() Clipboard.set(txt) end,
		function() Clipboard.Set(txt) end,
	}
	for _, f in ipairs(tries) do
		if pcall(f) then
			setStatus(okMsg)
			return true
		end
	end
	local fname = "VuDong_Copy.txt"
	local saved = pcall(writefile, fname, txt)
	local chunk, size, total = {}, 0, 0
	for ln in string.gmatch(txt, "[^\n]+") do
		table.insert(chunk, ln)
		size += #ln + 1
		if size >= 6000 then
			print(table.concat(chunk, "\n"))
			total += size
			chunk, size = {}, 0
			if total >= 60000 then break end
		end
	end
	if #chunk > 0 then print(table.concat(chunk, "\n")) end
	local msg = saved and ("Executor không có clipboard - đã lưu file " .. fname .. " và in ra console (F9)")
		or "Executor không có clipboard - đã in ra console (F9)"
	setStatus(msg)
	addLog(msg, Enum.MessageType.MessageInfo)
	return false
end

