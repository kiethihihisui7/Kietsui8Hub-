	-- logic chặt cây (dùng chung cho Forest, Autumn, Sakura, Snow, Desert, Water, Vulcano, Celestial, Void và Nghĩa Trang Ma Ám qua makeChopper)
	local eggBusy = false -- true khi "Tự Động Nhặt Egg" đang đi nhặt: chặt cây tạm dừng để không giành nhân vật

	local function matchAny(name, words)
		name = string.lower(name)
		for _, w in ipairs(words) do
			if string.find(name, w, 1, true) then return true end
		end
		return false
	end

	local function posOf(inst)
		if inst:IsA("Model") then
			return inst:GetPivot().Position
		elseif inst:IsA("BasePart") then
			return inst.Position
		end
		return nil
	end

	-- độ thẳng đứng của cây: 1 = thẳng, 0 = nằm ngang
	local function upY(inst)
		if inst:IsA("Model") then
			return inst:GetPivot().UpVector.Y
		elseif inst:IsA("BasePart") then
			return inst.CFrame.UpVector.Y
		end
		return 1
	end

	-- vật nằm trong một nhân vật (người chơi / NPC có Humanoid) thì không phải cây
	local function inCharacter(inst)
		local a = inst
		while a and a ~= workspace do
			if a:IsA("Model") and a:FindFirstChildOfClass("Humanoid") then return true end
			a = a.Parent
		end
		return false
	end

	-- Các chức năng làm nhân vật tự di chuyển / dịch chuyển (chặt cây Forest, Autumn, Sakura, Snow, Desert, Water, Vulcano, Celestial, Void, Nghĩa Trang Ma Ám, nhặt egg) chỉ chạy MỘT cái một lúc:
	-- bật cái nào thì các cái còn lại tự tắt.
	local EXCLUSIVE_TOGGLES = { TOGGLE_NAME, AUTUMN_TOGGLE, SAKURA_TOGGLE, SNOW_TOGGLE, DESERT_TOGGLE, WATER_TOGGLE, VULCANO_TOGGLE, CELESTIAL_TOGGLE, VOID_TOGGLE, GRAVEYARD_TOGGLE, EGG_PICK_TOGGLE }
	local function exclusive(me)
		if not State.__set then return end
		for _, n in ipairs(EXCLUSIVE_TOGGLES) do
			if n ~= me and State[n] and State.__set[n] then State.__set[n](false) end
		end
	end
	local ZONE_CENTERS = { FOREST_POS, AUTUMN_POS, SAKURA_POS, SNOW_POS, DESERT_POS, WATER_POS, VULCANO_POS, CELESTIAL_POS, VOID_POS, GRAVEYARD_POS } -- tâm các khu chặt cây (chia vùng theo tâm gần nhất)

	local function makeChopper(ZONE_NAME, ZONE_POS, ZONE_RADIUS, ZONE_TOGGLE)
		-- cây thuộc khu này: trong bán kính ZONE_RADIUS và gần tâm khu này hơn tâm các khu khác (để hai khu không chặt nhầm cây của nhau)
		local function inMyZone(p)
			if (p - ZONE_POS).Magnitude > ZONE_RADIUS then return false end
			if ZONE_SPLIT then
				local mine = (p - ZONE_POS).Magnitude
				for _, c in ipairs(ZONE_CENTERS) do
					if c ~= ZONE_POS and (p - c).Magnitude < mine then return false end
				end
			end
			return true
		end

		local runId = 0 -- mỗi lần bật / tắt tăng 1, vòng lặp cũ thấy khác số thì tự dừng
		local skip = setmetatable({}, { __mode = "k" }) -- cây -> thời điểm hết hạn bỏ qua
		local lastMsg = nil
		local eggs, eggConn = {}, nil -- trứng mới xuất hiện: { inst, t }
		local prevPos, prevAt = nil, 0 -- vị trí / thời điểm cây vừa chặt xong (để không nhầm trứng rơi trễ của cây trước)

		local function say(key, text)
			if lastMsg ~= key then
				lastMsg = key
				setStatus(text)
			end
		end

		-- trả về danh sách cây (vật ngoài cùng, không lấy từng mảnh con) thuộc khu này
		local function scanTrees()
			local set, found = {}, {}
			for _, d in ipairs(workspace:GetDescendants()) do
				if (d:IsA("Model") or d:IsA("BasePart")) and matchAny(d.Name, TREE_KEYWORDS) and not inCharacter(d) then
					local p = posOf(d)
					if p and inMyZone(p) then
						set[d] = true
						table.insert(found, d)
					end
				end
			end
			local now = os.clock()
			local out = {}
			for _, d in ipairs(found) do
				local nested = false
				local a = d.Parent
				while a and a ~= workspace do
					if set[a] then nested = true break end
					a = a.Parent
				end
				local expire = skip[d]
				if not nested and not (expire and now < expire) then
					table.insert(out, d)
				end
			end
			return out
		end

		-- tìm rìu: đang cầm thì dùng luôn, trong Túi Đồ thì cầm lên; không có rìu thì dùng Tool đang cầm (nếu có)
		local function findAxe(char, hum)
			for _, t in ipairs(char:GetChildren()) do
				if t:IsA("Tool") and matchAny(t.Name, AXE_KEYWORDS) then return t end
			end
			local bp = player:FindFirstChildOfClass("Backpack")
			if bp then
				for _, t in ipairs(bp:GetChildren()) do
					if t:IsA("Tool") and matchAny(t.Name, AXE_KEYWORDS) then
						pcall(function() hum:EquipTool(t) end)
						return t
					end
				end
			end
			return char:FindFirstChildOfClass("Tool")
		end

		-- đọc máu từ một thanh HP (BillboardGui / SurfaceGui): chữ "30/100", "45%" hoặc độ dài thanh Fill. Trả về cur, max
		local function guiHp(gui)
			local fill, fillScore
			for _, g in ipairs(gui:GetDescendants()) do
				if g:IsA("TextLabel") or g:IsA("TextButton") then
					local c, m = string.match(g.Text, "(%d+%.?%d*)%s*/%s*(%d+%.?%d*)")
					if c then return tonumber(c), tonumber(m) end
					local pct = string.match(g.Text, "(%d+%.?%d*)%s*%%")
					if pct then return tonumber(pct), 100 end
				elseif g:IsA("GuiObject") and matchAny(g.Name, BAR_KEYWORDS) then
					local n = string.lower(g.Name)
					local score = 1
					if string.find(n, "fill", 1, true) then
						score = 3
					elseif string.find(n, "hp", 1, true) or string.find(n, "health", 1, true) or string.find(n, "máu", 1, true) then
						score = 2
					end
					if not fillScore or score > fillScore then fill, fillScore = g, score end
				end
			end
			if fill then
				local s = fill.Size.X.Scale
				if s == 0 and fill.Size.X.Offset > 0 and fill.Parent and fill.Parent:IsA("GuiObject") and fill.Parent.AbsoluteSize.X > 0 then
					s = fill.AbsoluteSize.X / fill.Parent.AbsoluteSize.X
				end
				return s, 1
			end
			return nil
		end

		-- đọc máu của cây. Trả về cur, max, nguồn, gui (gui chỉ có khi đọc từ thanh HP, để theo dõi "thanh HP biến mất")
		local function hpOf(tree)
			local hum = tree:FindFirstChildWhichIsA("Humanoid", true)
			if hum then return hum.Health, hum.MaxHealth, "Humanoid", nil end
			local cur, mx
			for k, v in pairs(tree:GetAttributes()) do
				if type(v) == "number" and matchAny(k, HP_KEYWORDS) then
					if string.find(string.lower(k), "max", 1, true) then mx = v else cur = v end
				end
			end
			if cur then return cur, mx, "thuộc tính", nil end
			local guis = {}
			for _, d in ipairs(tree:GetDescendants()) do
				if d:IsA("NumberValue") or d:IsA("IntValue") then
					if matchAny(d.Name, HP_KEYWORDS) then
						if string.find(string.lower(d.Name), "max", 1, true) then mx = d.Value else cur = d.Value end
					end
				elseif d:IsA("BillboardGui") or d:IsA("SurfaceGui") then
					table.insert(guis, d)
				end
			end
			if cur then return cur, mx, "giá trị", nil end
			for _, g in ipairs(guis) do
				local c, m = guiHp(g)
				if c then return c, m, "thanh HP", g end
			end
			return nil
		end

		-- có trứng nào xuất hiện sau khi bắt đầu chặt cây này, gần cây hoặc gần nhân vật không
		local function eggNear(st, tp, root)
			local now = os.clock()
			local keep, hit = {}, nil
			for _, e in ipairs(eggs) do
				if now - e.t < 60 then
					table.insert(keep, e)
					if not hit and e.t >= st.t0 and e.inst.Parent then
						local p = posOf(e.inst)
						if p and ((p - tp).Magnitude <= EGG_RADIUS or (p - root.Position).Magnitude <= EGG_RADIUS) then
							local late = prevPos and e.t <= prevAt + EGG_GRACE and (p - prevPos).Magnitude <= EGG_RADIUS
							if not late then hit = e.inst end
						end
					end
				end
			end
			eggs = keep
			return hit
		end

		-- cây đã đổ chưa? trả về lý do (chuỗi) hoặc nil nếu chưa
		local function doneReason(tree, st, root, tp)
			if not tree.Parent then return "cây biến mất" end
			if DETECT_HP then
				local cur, _, src, gui = hpOf(tree)
				if gui then st.gui = gui end
				if cur then
					if cur > 0 then
						st.hpPos = true
					elseif st.hpPos or st.swings >= 4 then
						return "HP = 0 (" .. src .. ")"
					end
				end
				if st.gui and (not st.gui.Parent or st.gui.Enabled == false) then return "thanh HP biến mất" end
			end
			if DETECT_EGG then
				local egg = eggNear(st, tp, root)
				if egg then return "trứng xuất hiện: " .. egg.Name end
			end
			if DETECT_TILT and upY(tree) < st.up0 - 0.3 then return "cây đổ nghiêng" end
			return nil
		end

		-- chặt một cây tới khi nó đổ (hoặc hết giờ). Xong thì cycle sẽ dịch chuyển sang cây khác.
		local function chopTree(tree, my)
			local st = { t0 = os.clock(), swings = 0, hpPos = false, gui = nil, up0 = upY(tree), lost = 0 }
			local reason, lastTp = nil, posOf(tree)
			say("chop " .. tree.Name, ZONE_NAME .. ": đang chặt " .. tree.Name)
			while runId == my do
				if eggBusy then -- đang nhặt trứng: chờ xong rồi chặt tiếp (thời gian chờ không tính vào MAX_PER_TREE)
					local ps = os.clock()
					while eggBusy and runId == my do task.wait(0.1) end
					st.lost = st.lost + (os.clock() - ps)
					if runId ~= my then break end
				end
				local char = player.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				local root = char and char:FindFirstChild("HumanoidRootPart")
				if not (hum and root and hum.Health > 0) then return end
				local tp = posOf(tree) or lastTp
				lastTp = tp

				reason = doneReason(tree, st, root, tp)
				if reason then break end
				if os.clock() - st.t0 - st.lost >= MAX_PER_TREE then
					reason = false
					break
				end

				-- dịch chuyển sát cây (cùng độ cao với nhân vật), quay mặt vào cây
				local rp = root.Position
				if (Vector3.new(rp.X, 0, rp.Z) - Vector3.new(tp.X, 0, tp.Z)).Magnitude > CHOP_REACH + 3 then
					local dir = Vector3.new(rp.X - tp.X, 0, rp.Z - tp.Z)
					if dir.Magnitude < 0.1 then dir = Vector3.new(0, 0, 1) end
					local stand = tp + dir.Unit * CHOP_REACH
					root.CFrame = CFrame.new(stand.X, rp.Y, stand.Z)
					root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
				end
				root.CFrame = CFrame.lookAt(root.Position, Vector3.new(tp.X, root.Position.Y, tp.Z))

				-- cầm rìu và chặt
				local tool = findAxe(char, hum)
				if tool and tool.Parent == char then tool:Activate() end
				local pp = tree:FindFirstChildWhichIsA("ProximityPrompt", true)
				if pp and fireproximityprompt then pcall(fireproximityprompt, pp) end
				local cd = tree:FindFirstChildWhichIsA("ClickDetector", true)
				if cd and fireclickdetector then pcall(fireclickdetector, cd) end
				st.swings = st.swings + 1

				task.wait(CHOP_DELAY)
			end
			if runId ~= my then return end -- đã tắt công tắc giữa chừng
			prevPos, prevAt = lastTp, os.clock()
			if reason then
				skip[tree] = os.clock() + DONE_TIME
				setStatus(ZONE_NAME .. ": cây đổ (" .. reason .. ") - sang cây khác")
			else
				skip[tree] = os.clock() + SKIP_TIME
				setStatus(ZONE_NAME .. ": bỏ qua " .. tree.Name .. " (chặt " .. MAX_PER_TREE .. "s chưa thấy đổ, kiểm tra từ khóa HP / trứng)")
			end
		end

		local function cycle(my)
			local char = player.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if not (hum and root and hum.Health > 0) then
				task.wait(1)
				return
			end
			if (root.Position - ZONE_POS).Magnitude > ZONE_RADIUS then
				say("tp", ZONE_NAME .. ": đang dịch chuyển tới khu vực")
				root.CFrame = CFrame.new(ZONE_POS)
				root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
				task.wait(0.5)
			end

			local trees = scanTrees()
			if #trees == 0 then
				local now, waiting = os.clock(), false
				for _, expire in pairs(skip) do
					if expire > now then waiting = true break end
				end
				if waiting then
					say("regrow", ZONE_NAME .. ": đã chặt hết cây, chờ cây mọc lại")
				else
					say("none", ZONE_NAME .. ": chưa thấy cây nào (kiểm tra TREE_KEYWORDS)")
				end
				task.wait(RESCAN_WAIT)
				return
			end
			-- lần lượt chọn cây gần nhất so với vị trí hiện tại -> dịch chuyển sang đó chặt
			while #trees > 0 and runId == my do
				local c = player.Character
				local r = c and c:FindFirstChild("HumanoidRootPart")
				if not r then return end
				local bi, bd = nil, nil
				for i, t in ipairs(trees) do
					local p = t.Parent and posOf(t)
					if p then
						local d = (p - r.Position).Magnitude
						if not bd or d < bd then bi, bd = i, d end
					end
				end
				if not bi then return end
				chopTree(table.remove(trees, bi), my)
			end
		end

		Callbacks[ZONE_TOGGLE] = function(on)
			if on then exclusive(ZONE_TOGGLE) end -- loại trừ nhau với các chức năng di chuyển khác
			runId = runId + 1
			lastMsg = nil
			if eggConn then
				eggConn:Disconnect()
				eggConn = nil
			end
			eggs = {}
			if not on then return end
			-- theo dõi trứng xuất hiện trong workspace
			eggConn = workspace.DescendantAdded:Connect(function(d)
				if (d:IsA("Model") or d:IsA("BasePart")) and matchAny(d.Name, EGG_KEYWORDS) then
					table.insert(eggs, { inst = d, t = os.clock() })
				end
			end)
			local my = runId
			task.spawn(function()
				while runId == my do
					local ok, err = pcall(cycle, my)
					if not ok then
						warn("[" .. ZONE_NAME .. "] " .. tostring(err))
						task.wait(1)
					end
					task.wait()
				end
			end)
		end
	end

	makeChopper("Forest", FOREST_POS, FOREST_RADIUS, TOGGLE_NAME)
	makeChopper("Autumn", AUTUMN_POS, AUTUMN_RADIUS, AUTUMN_TOGGLE)
	makeChopper("Sakura", SAKURA_POS, SAKURA_RADIUS, SAKURA_TOGGLE)
	makeChopper("Snow", SNOW_POS, SNOW_RADIUS, SNOW_TOGGLE)
	makeChopper("Desert", DESERT_POS, DESERT_RADIUS, DESERT_TOGGLE)
	makeChopper("Water", WATER_POS, WATER_RADIUS, WATER_TOGGLE)
	makeChopper("Vulcano", VULCANO_POS, VULCANO_RADIUS, VULCANO_TOGGLE)
	makeChopper("Celestial", CELESTIAL_POS, CELESTIAL_RADIUS, CELESTIAL_TOGGLE)
	makeChopper("Void", VOID_POS, VOID_RADIUS, VOID_TOGGLE)
	makeChopper("Nghĩa Trang Ma Ám", GRAVEYARD_POS, GRAVEYARD_RADIUS, GRAVEYARD_TOGGLE)


	----------------------------------------------------------------
	-- Tự Động Nhặt Egg (quanh chỗ Player đang đứng lúc bật)
	-- Theo dõi mọi vật tên chứa EGG_KEYWORDS trong workspace (quét 1 lần khi bật, sau đó nghe DescendantAdded),
	-- chọn quả gần nhất trong bán kính EGG_PICK_RADIUS quanh chỗ nhân vật đứng lúc bật (eggCenter) rồi dịch chuyển tới đứng lên quả đó
	-- và kích hoạt: chạm (firetouchinterest), ProximityPrompt (fireproximityprompt), ClickDetector (fireclickdetector).
	-- Quả biến mất khỏi workspace = đã nhặt. Quả nhặt không được thì bỏ qua EGG_PICK_SKIP giây.
	----------------------------------------------------------------
	local eggRun = 0 -- mỗi lần bật / tắt tăng 1, vòng lặp cũ thấy khác số thì tự dừng
	local eggSet = setmetatable({}, { __mode = "k" }) -- các vật trông giống trứng đang có trong workspace
	local eggSkip = setmetatable({}, { __mode = "k" }) -- trứng -> thời điểm hết hạn bỏ qua
	local eggAddConn, eggRemConn = nil, nil
	local eggTotal, lastEggMsg = 0, nil
	local eggIdleSince = nil -- thời điểm bắt đầu không còn trứng (để chờ EGG_EMPTY_WAIT giây rồi về)

	local function sayEgg(key, text)
		if lastEggMsg ~= key then
			lastEggMsg = key
			setStatus(text)
		end
	end

	-- trứng có chủ là người chơi khác không (thuộc tính / giá trị tên chứa owner, userid, player)
	local function ownedByOther(inst)
		local function check(o)
			for k, v in pairs(o:GetAttributes()) do
				local kl = string.lower(k)
				local isOwnerKey = string.find(kl, "owner", 1, true) or string.find(kl, "userid", 1, true)
				if type(v) == "number" and isOwnerKey and v ~= 0 and v ~= player.UserId then return true end
				if type(v) == "string" and v ~= "" and (isOwnerKey or string.find(kl, "player", 1, true))
					and v ~= player.Name and v ~= player.DisplayName and v ~= tostring(player.UserId) then
					return true
				end
			end
			for _, c in ipairs(o:GetChildren()) do
				if string.find(string.lower(c.Name), "owner", 1, true) then
					if c:IsA("ObjectValue") then
						local v = c.Value
						if v and v:IsA("Player") and v ~= player then return true end
						if v and v:IsA("Model") and v:FindFirstChildOfClass("Humanoid") and v ~= player.Character then return true end
					elseif c:IsA("StringValue") then
						if c.Value ~= "" and c.Value ~= player.Name and c.Value ~= player.DisplayName and c.Value ~= tostring(player.UserId) then return true end
					elseif c:IsA("IntValue") or c:IsA("NumberValue") then
						if c.Value ~= 0 and c.Value ~= player.UserId then return true end
					end
				end
			end
			return false
		end
		if check(inst) then return true end
		local par = inst.Parent
		return par ~= nil and par ~= workspace and check(par)
	end

	-- kích hoạt nhặt một quả trứng: chạm + ProximityPrompt + ClickDetector
	local function triggerEgg(egg, root)
		local items, parts = { egg }, 0
		for _, d in ipairs(egg:GetDescendants()) do table.insert(items, d) end
		for _, d in ipairs(items) do
			if d:IsA("ProximityPrompt") then
				if fireproximityprompt then
					pcall(function() d.HoldDuration = 0 end)
					pcall(fireproximityprompt, d)
				end
			elseif d:IsA("ClickDetector") then
				if fireclickdetector then pcall(fireclickdetector, d) end
			elseif d:IsA("BasePart") and parts < 12 and firetouchinterest then
				parts = parts + 1
				pcall(firetouchinterest, root, d, 0)
				pcall(firetouchinterest, root, d, 1)
			end
		end
	end

	local function eggGone(egg)
		return not egg:IsDescendantOf(workspace) or inCharacter(egg)
	end

	-- nhặt một quả: true nếu nhặt được (quả biến mất), false nếu hết giờ / nhân vật chết
	local function grabEgg(egg, my)
		local t0 = os.clock()
		while eggRun == my and os.clock() - t0 < EGG_PICK_TIME do
			if eggGone(egg) then return true end
			local char = player.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if not (hum and root and hum.Health > 0) then return false end
			local p = posOf(egg)
			if not p then return true end
			root.CFrame = CFrame.new(p + Vector3.new(0, 2.5, 0))
			root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
			triggerEgg(egg, root)
			task.wait(0.2)
		end
		return eggGone(egg)
	end

	-- danh sách trứng hợp lệ (vật ngoài cùng, trong bán kính, không bị bỏ qua, không của người khác)
	local function scanEggList()
		local out, now = {}, os.clock()
		for e in pairs(eggSet) do
			local expire = eggSkip[e]
			if e.Parent and e:IsDescendantOf(workspace) and not inCharacter(e) and not (expire and now < expire) then
				local nested = false
				local a = e.Parent
				while a and a ~= workspace do
					if eggSet[a] then nested = true break end
					a = a.Parent
				end
				local p = posOf(e)
				if not nested and p and eggCenter and (p - eggCenter).Magnitude <= EGG_PICK_RADIUS
					and not (EGG_OWNER_CHECK and ownedByOther(e)) then
					table.insert(out, e)
				end
			end
		end
		return out
	end

	-- bay về nhà (không dịch chuyển): mỗi khung hình đẩy nhân vật một đoạn về phía nhà, tắt va chạm khi bay để không kẹt tường
	local function flyHome(home, my)
		local c0 = player.Character
		local saved = {}
		if c0 then
			for _, d in ipairs(c0:GetDescendants()) do
				if d:IsA("BasePart") and d.CanCollide then
					saved[#saved + 1] = d
					d.CanCollide = false
				end
			end
		end
		local arrived = false
		local t0 = os.clock()
		while eggRun == my and os.clock() - t0 < EGG_FLY_MAX do
			local dt = RunService.Heartbeat:Wait()
			local c = player.Character
			local r = c and c:FindFirstChild("HumanoidRootPart")
			local hum = c and c:FindFirstChildOfClass("Humanoid")
			if not (r and hum and hum.Health > 0) then break end
			local delta = home.Position - r.Position
			local dist = delta.Magnitude
			if dist <= 0.5 then
				r.CFrame = home
				r.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
				arrived = true
				break
			end
			local step = math.min(dist, EGG_FLY_SPEED * dt)
			r.CFrame = CFrame.new(r.Position + delta.Unit * step) * (r.CFrame - r.CFrame.Position)
			r.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
			r.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
			sayEgg("fly", "Nhặt Egg: đang bay về nhà...")
		end
		for _, d in ipairs(saved) do -- trả lại va chạm
			pcall(function() d.CanCollide = true end)
		end
		return arrived
	end

	-- nhặt đủ số lượng: BAY về nhà rồi tự tắt công tắc Nhặt Egg, KHÔNG quay lại chỗ nhặt nữa
	local function finishEggs(reason)
		eggBusy = false
		eggRun = eggRun + 1 -- dừng hẳn vòng nhặt trước khi bay: không quay lại nhặt nữa
		local my = eggRun
		local n = eggTotal
		local home = plotHome or eggHome -- ưu tiên vị trí mảnh đất đã lưu, không có thì dùng dự phòng
		if home then
			flyHome(home, my)
		else
			setStatus("Nhặt Egg: chưa có vị trí nhà để bay về (bấm \"Lưu Vị Trí Này\" khi đứng ở nhà)")
		end
		if eggRun ~= my then return end -- công tắc đã bị đổi trong lúc bay: không tắt đè
		if State.__set and State.__set[EGG_PICK_TOGGLE] then State.__set[EGG_PICK_TOGGLE](false) end
		setStatus("Nhặt Egg: " .. (reason or ("đã đủ " .. n .. " quả")) .. " - đã bay về nhà")
	end

	local function eggPass(my)
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not (hum and root and hum.Health > 0) then
			task.wait(1)
			return
		end
		if not eggCenter then eggCenter = root.Position end -- chưa có tâm (lúc bật chưa có nhân vật): lấy chỗ đang đứng
		local list = scanEggList()
		if #list == 0 then
			if EGG_FINISH_WHEN_EMPTY and eggTotal > 0 then
				eggIdleSince = eggIdleSince or os.clock()
				if os.clock() - eggIdleSince >= EGG_EMPTY_WAIT then
					finishEggs("hết trứng (đã nhặt " .. eggTotal .. " quả)")
					return
				end
				sayEgg("idle", "Nhặt Egg: hết trứng, chờ " .. EGG_EMPTY_WAIT .. "s rồi dịch chuyển về")
			else
				sayEgg("none", "Nhặt Egg: chưa thấy trứng nào quanh chỗ đang đứng (bán kính " .. EGG_PICK_RADIUS .. ")")
			end
			task.wait(EGG_PICK_WAIT)
			return
		end
		eggIdleSince = nil
		eggBusy = true
		while #list > 0 and eggRun == my do
			local c = player.Character
			local r = c and c:FindFirstChild("HumanoidRootPart")
			if not r then break end
			local bi, bd = nil, nil
			for i, e in ipairs(list) do
				local p = e.Parent and posOf(e)
				if p then
					local d = (p - r.Position).Magnitude
					if not bd or d < bd then bi, bd = i, d end
				end
			end
			if not bi then break end
			local egg = table.remove(list, bi)
			sayEgg("grab " .. egg.Name, "Nhặt Egg: đang nhặt " .. egg.Name)
			if grabEgg(egg, my) then
				eggTotal = eggTotal + 1
				if eggTarget > 0 and eggTotal >= eggTarget then
					finishEggs()
					return
				end
				setStatus("Nhặt Egg: đã nhặt " .. eggTotal .. (eggTarget > 0 and ("/" .. eggTarget) or "") .. " quả")
				lastEggMsg = nil
			elseif eggRun == my then
				eggSkip[egg] = os.clock() + EGG_PICK_SKIP
				setStatus("Nhặt Egg: bỏ qua " .. egg.Name .. " (nhặt " .. EGG_PICK_TIME .. "s không được, kiểm tra từ khóa trứng / cách nhặt)")
			end
		end
		eggBusy = false
	end

	Callbacks[EGG_PICK_TOGGLE] = function(on)
		if on then exclusive(EGG_PICK_TOGGLE) end -- loại trừ nhau với Chặt Cây Forest / Autumn / Sakura / Snow / Desert / Water / Vulcano / Celestial / Void / Nghĩa Trang Ma Ám
		eggRun = eggRun + 1
		eggBusy = false
		lastEggMsg = nil
		eggTotal = 0
		eggIdleSince = nil
		if eggAddConn then
			eggAddConn:Disconnect()
			eggAddConn = nil
		end
		if eggRemConn then
			eggRemConn:Disconnect()
			eggRemConn = nil
		end
		eggSet = setmetatable({}, { __mode = "k" })
		eggSkip = setmetatable({}, { __mode = "k" })
		if not on then return end
		local c0 = player.Character
		local r0 = c0 and c0:FindFirstChild("HumanoidRootPart")
		eggCenter = r0 and r0.Position -- chốt tâm nhặt egg = chỗ đang đứng lúc bật
		eggHome = EGG_HOME_POS and CFrame.new(EGG_HOME_POS) or (r0 and r0.CFrame) -- chỗ dự phòng nếu chưa lưu được vị trí mảnh đất
		for _, d in ipairs(workspace:GetDescendants()) do
			if (d:IsA("Model") or d:IsA("BasePart")) and matchAny(d.Name, EGG_KEYWORDS) then eggSet[d] = true end
		end
		eggAddConn = workspace.DescendantAdded:Connect(function(d)
			if (d:IsA("Model") or d:IsA("BasePart")) and matchAny(d.Name, EGG_KEYWORDS) then eggSet[d] = true end
		end)
		eggRemConn = workspace.DescendantRemoving:Connect(function(d)
			eggSet[d] = nil
		end)
		local my = eggRun
		task.spawn(function()
			while eggRun == my do
				local ok, err = pcall(eggPass, my)
				if not ok then
					eggBusy = false
					warn("[Nhặt Egg] " .. tostring(err))
					task.wait(1)
				end
				task.wait()
			end
		end)
	end
end) -- hết khối TAB FOREST

