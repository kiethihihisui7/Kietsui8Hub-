	local SCAN_CHEST_IGNORE = { "plate", "armor", "armour" }
	local CATS = { "Tất Cả", "Model", "Part", "Tool", "Tương Tác", "NPC", "Rương", "Spawn/Ghế" }
	local SCAN_IDLE = 'Chưa quét. Bấm "Quét Toàn Bộ Map" để đọc mọi vật trong workspace: tên, loại, đường dẫn, vị trí, kích thước... (Bán Kính 0 = toàn map).'

	local scanCard = card(setCard.Parent, 3, "🗺️", "Quét Map", "Đọc & quét vị trí vật trong toàn bộ map", Color3.fromRGB(52, 211, 153))
	rainbowCard(scanCard)

	local all, view, marks = {}, {}, {} -- all = mọi vật đã quét, view = vật sau khi lọc, marks = nhãn 3D
	local summaryLines = {}
	local catFilter, radius, curPage, busy = "Tất Cả", 0, 1, false
	local scanLabel -- khung chữ kết quả (tạo ở dưới)
	local copier = { nextIdx = 1 } -- vị trí vật tiếp theo cần chép (chép từng phần)

	local function fmtV(v)
		return string.format("%.1f, %.1f, %.1f", v.X, v.Y, v.Z)
	end

	local function getRoot()
		local ch = player.Character
		return ch and ch:FindFirstChild("HumanoidRootPart")
	end

	local function isChest(name)
		local l = string.lower(name)
		for _, bad in ipairs(SCAN_CHEST_IGNORE) do
			if string.find(l, bad, 1, true) then return false end
		end
		for _, kw in ipairs(SCAN_CHEST) do
			if string.find(l, kw, 1, true) then return true end
		end
		return false
	end

	-- phân loại một đối tượng (nil = bỏ qua)
	local function classify(inst)
		if inst:IsA("ProximityPrompt") or inst:IsA("ClickDetector") then return "Tương Tác" end
		if inst:IsA("Tool") then return "Tool" end
		if inst:IsA("Model") then
			if inst:FindFirstChildOfClass("Humanoid") then return "NPC" end
			if isChest(inst.Name) then return "Rương" end
			return "Model"
		end
		if inst:IsA("BasePart") then
			if inst:IsA("Terrain") then return nil end
			if inst:IsA("SpawnLocation") or inst:IsA("Seat") or inst:IsA("VehicleSeat") then return "Spawn/Ghế" end
			if isChest(inst.Name) then return "Rương" end
			return "Part"
		end
		return nil
	end

	-- vị trí của đối tượng (Prompt / Click lấy theo vật cha)
	local function posOf(inst)
		local ok, p = pcall(function()
			if inst:IsA("BasePart") then return inst.Position end
			if inst:IsA("Model") then return inst:GetPivot().Position end
			if inst:IsA("Tool") then
				local h = inst:FindFirstChild("Handle")
				if h and h:IsA("BasePart") then return h.Position end
			end
			local par = inst.Parent
			while par and par ~= workspace do
				if par:IsA("BasePart") then return par.Position end
				if par:IsA("Model") then return par:GetPivot().Position end
				par = par.Parent
			end
			return nil
		end)
		if ok then return p end
		return nil
	end

	-- thông tin thêm (tính khi cần hiển thị, không tính lúc quét cho nhẹ)
	local function extraOf(inst)
		local t = {}
		pcall(function()
			if inst:IsA("BasePart") then
				table.insert(t, "Size " .. fmtV(inst.Size))
				table.insert(t, inst.Anchored and "Anchored" or "Free")
				table.insert(t, inst.CanCollide and "CanCollide" or "NoCollide")
				if inst.Transparency >= 1 then table.insert(t, "vô hình") end
			elseif inst:IsA("Model") then
				local hum = inst:FindFirstChildOfClass("Humanoid")
				if hum then
					table.insert(t, string.format("Máu %.0f/%.0f", hum.Health, hum.MaxHealth))
					if Players:GetPlayerFromCharacter(inst) then table.insert(t, "người chơi") end
				end
				if inst.PrimaryPart then table.insert(t, "PrimaryPart=" .. inst.PrimaryPart.Name) end
				table.insert(t, #inst:GetChildren() .. " con")
			elseif inst:IsA("ProximityPrompt") then
				table.insert(t, string.format("ActionText=%q ObjectText=%q Hold=%.1fs Tầm=%.0f %s", inst.ActionText, inst.ObjectText,
					inst.HoldDuration, inst.MaxActivationDistance, inst.Enabled and "Bật" or "Tắt"))
			elseif inst:IsA("ClickDetector") then
				table.insert(t, string.format("Tầm=%.0f", inst.MaxActivationDistance))
			elseif inst:IsA("Tool") then
				table.insert(t, inst:FindFirstChild("Handle") and "có Handle" or "không Handle")
			end
		end)
		pcall(function()
			local n = 0
			for k, v in pairs(inst:GetAttributes()) do
				n += 1
				if n > 4 then break end
				table.insert(t, k .. "=" .. tostring(v))
			end
		end)
		return table.concat(t, " | ")
	end

	-- một dòng đầy đủ (dùng cho sao chép / lưu file / console)
	local function fullLine(i, e)
		local parts = {
			string.format("#%d [%s] %s", i, e.cat, e.cls),
			pathOf(e.inst),
			e.pos and string.format("Vector3.new(%.2f, %.2f, %.2f)", e.pos.X, e.pos.Y, e.pos.Z) or "không rõ vị trí",
		}
		if e.dist then table.insert(parts, string.format("cách %.1f stud", e.dist)) end
		local x = extraOf(e.inst)
		if x ~= "" then table.insert(parts, x) end
		return table.concat(parts, " | ")
	end

	local function buildReport(maxLines)
		local lines = { "=== Vu Dong Script - Quét Map (PlaceId " .. tostring(game.PlaceId) .. ") ===" }
		for _, s in ipairs(summaryLines) do table.insert(lines, s) end
		table.insert(lines, string.format("Bộ lọc: %s | Bán kính: %s | %d kết quả", catFilter,
			radius > 0 and (radius .. " stud") or "toàn map", #view))
		table.insert(lines, "--------------------------------------------")
		for i = 1, math.min(#view, maxLines) do
			table.insert(lines, fullLine(i, view[i]))
			if i % 1500 == 0 then task.wait() end
		end
		if #view > maxLines then
			table.insert(lines, "... còn " .. (#view - maxLines) .. " dòng nữa (dùng nút Lưu File để lấy đủ)")
		end
		return table.concat(lines, "\n")
	end

	-- chép từng phần: mỗi lần tối đa SCAN_COPY_MAX ký tự, bấm "Sao Chép Phần Tiếp" để chép phần sau
	function copier.run(reset)
		if #all == 0 then
			setStatus("Hãy quét map trước")
			return
		end
		if #view == 0 then
			setStatus("Không có kết quả khớp bộ lọc để chép")
			return
		end
		if reset then copier.nextIdx = 1 end
		local from = copier.nextIdx
		if from > #view then
			setStatus("Đã chép hết - bấm Sao Chép Kết Quả để chép lại từ đầu")
			return
		end
		local lines, bytes = {}, 0
		if from == 1 then
			table.insert(lines, "=== Vu Dong Script - Quét Map (PlaceId " .. tostring(game.PlaceId) .. ") ===")
			for _, s in ipairs(summaryLines) do table.insert(lines, s) end
			table.insert(lines, string.format("Bộ lọc: %s | Bán kính: %s | %d kết quả", catFilter,
				radius > 0 and (radius .. " stud") or "toàn map", #view))
			table.insert(lines, "--------------------------------------------")
			for _, s in ipairs(lines) do bytes += #s + 1 end
		end
		local i = from
		while i <= #view do
			local ln = fullLine(i, view[i])
			if bytes + #ln + 1 > SCAN_COPY_MAX and i > from then break end
			table.insert(lines, ln)
			bytes += #ln + 1
			i += 1
			if i % 1000 == 0 then task.wait() end
		end
		local last = i - 1
		local msg = string.format("Đã chép #%d-#%d / %d%s", from, last, #view,
			last < #view and " - bấm Sao Chép Phần Tiếp để chép tiếp" or " (hết)")
		if copyText(table.concat(lines, "\n"), msg) then
			copier.nextIdx = last + 1
		end
	end

	-- hiển thị kết quả trong khung chữ
	local function render()
		if not scanLabel then return end
		if #all == 0 then
			scanLabel.Text = esc(SCAN_IDLE)
			return
		end
		local hex = theme.accent2:ToHex()
		local out = {}
		for _, s in ipairs(summaryLines) do table.insert(out, esc(s)) end
		local totalPages = math.max(1, math.ceil(#view / SCAN_PAGE))
		curPage = math.clamp(curPage, 1, totalPages)
		table.insert(out, string.format('<font color="#%s">── Trang %d/%d · %d kết quả · lọc: %s · bán kính: %s ──</font>',
			hex, curPage, totalPages, #view, esc(catFilter), radius > 0 and (radius .. " stud") or "toàn map"))
		for i = (curPage - 1) * SCAN_PAGE + 1, math.min(#view, curPage * SCAN_PAGE) do
			local e = view[i]
			local where = e.pos and fmtV(e.pos) or "không rõ vị trí"
			local dist = e.dist and string.format(" · cách %.0f", e.dist) or ""
			table.insert(out, string.format('<font color="#%s">#%d [%s]</font> %s\n      %s%s',
				hex, i, esc(e.cat), esc(e.name), esc(where), dist))
		end
		if #view == 0 then table.insert(out, "(không có vật nào khớp bộ lọc)") end
		scanLabel.Text = table.concat(out, "\n")
	end

	-- lọc theo loại + bán kính, sắp xếp từ gần đến xa
	local function applyFilter()
		table.clear(view)
		copier.nextIdx = 1
		local root = getRoot()
		local rp = root and root.Position
		for _, e in ipairs(all) do
			if catFilter == "Tất Cả" or e.cat == catFilter then
				local d = (rp and e.pos) and (e.pos - rp).Magnitude or nil
				if radius <= 0 or (d and d <= radius) then
					e.dist = d
					table.insert(view, e)
				end
			end
		end
		table.sort(view, function(a, b)
			local da, db = a.dist or math.huge, b.dist or math.huge
			if da ~= db then return da < db end
			return a.name < b.name
		end)
	end

	-- nhãn 3D trong game: hiện tên + tọa độ trên các vật gần bạn nhất (xuyên tường)
	local function clearMarks()
		for _, g in ipairs(marks) do g:Destroy() end
		table.clear(marks)
	end

	local function adorneeOf(inst)
		if inst:IsA("BasePart") then return inst end
		if inst:IsA("Model") then return inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true) end
		if inst:IsA("Tool") then
			local h = inst:FindFirstChild("Handle")
			if h and h:IsA("BasePart") then return h end
		end
		local par = inst.Parent
		while par and par ~= workspace do
			if par:IsA("BasePart") then return par end
			if par:IsA("Model") then return par.PrimaryPart or par:FindFirstChildWhichIsA("BasePart", true) end
			par = par.Parent
		end
		return nil
	end

	local function drawMarks()
		clearMarks()
		if not State["Hiện Nhãn Vị Trí"] then return end
		local gui = player:FindFirstChildOfClass("PlayerGui")
		if not gui then return end
		for i = 1, math.min(#view, SCAN_MARKS) do
			local e = view[i]
			local ok, part = pcall(adorneeOf, e.inst)
			if ok and part and part.Parent then
				local bb = Instance.new("BillboardGui")
				bb.Name = "VuDongMapMark"
				bb.Adornee = part
				bb.AlwaysOnTop = true
				bb.ResetOnSpawn = false
				bb.Size = UDim2.fromOffset(220, 46)
				bb.StudsOffset = Vector3.new(0, 2, 0)
				bb.MaxDistance = 2000
				local t = Instance.new("TextLabel")
				t.BackgroundTransparency = 1
				t.Size = UDim2.fromScale(1, 1)
				t.Font = Enum.Font.SourceSansBold
				t.TextSize = 14
				t.TextWrapped = true
				t.TextColor3 = Color3.fromRGB(110, 231, 183)
				t.TextStrokeTransparency = 0
				t.Text = string.format("#%d %s\n%s", i, e.name, e.pos and fmtV(e.pos) or "")
				t.Parent = bb
				bb.Parent = gui
				table.insert(marks, bb)
			end
		end
	end

	-- đổi bộ lọc / bán kính: gom lại, chờ 0.25s rồi mới tính (kéo thanh trượt không bị giật)
	local refreshToken = 0
	local function refreshSoon()
		refreshToken += 1
		local my = refreshToken
		task.delay(0.25, function()
			if my == refreshToken and #all > 0 then
				applyFilter()
				render()
				drawMarks()
			end
		end)
	end

	-- QUÉT TOÀN BỘ MAP
	local function runScan()
		if busy then
			setStatus("Đang quét, chờ chút...")
			return
		end
		busy = true
		setStatus("Đang quét map...")
		local t0 = os.clock()
		table.clear(all)

		-- bỏ qua phần thân bên trong nhân vật người chơi (cho đỡ rối), vẫn giữ chính nhân vật
		local skip = {}
		for _, p in ipairs(Players:GetPlayers()) do
			local ch = p.Character
			if ch then
				for _, d in ipairs(ch:GetDescendants()) do skip[d] = true end
			end
		end

		local counts, capped = {}, false
		local minP, maxP, sumP, nPos = nil, nil, Vector3.zero, 0
		local ok, err = pcall(function()
			local n = 0
			for _, inst in ipairs(workspace:GetDescendants()) do
				n += 1
				if n % 1500 == 0 then task.wait() end -- nhường khung hình để game không đứng
				if not skip[inst] then
					local cat = classify(inst)
					if cat then
						local pos = posOf(inst)
						table.insert(all, { inst = inst, name = inst.Name, cls = inst.ClassName, cat = cat, pos = pos })
						counts[cat] = (counts[cat] or 0) + 1
						if pos then
							nPos += 1
							sumP += pos
							minP = minP and Vector3.new(math.min(minP.X, pos.X), math.min(minP.Y, pos.Y), math.min(minP.Z, pos.Z)) or pos
							maxP = maxP and Vector3.new(math.max(maxP.X, pos.X), math.max(maxP.Y, pos.Y), math.max(maxP.Z, pos.Z)) or pos
						end
						if #all >= SCAN_MAX then
							capped = true
							break
						end
					end
				end
			end
		end)
		busy = false
		if not ok then
			setStatus("Lỗi quét map: " .. tostring(err))
			addLog("Lỗi quét map: " .. tostring(err), Enum.MessageType.MessageError)
			return
		end

		table.clear(summaryLines)
		table.insert(summaryLines, string.format("Đã quét %d vật trong workspace (%.1f giây)", #all, os.clock() - t0))
		local cs = {}
		for _, name in ipairs(CATS) do
			if counts[name] then table.insert(cs, name .. " " .. counts[name]) end
		end
		table.insert(summaryLines, #cs > 0 and table.concat(cs, " · ") or "(không thấy vật nào)")
		if minP and maxP then
			table.insert(summaryLines, string.format("Khung map: X %.0f→%.0f | Y %.0f→%.0f | Z %.0f→%.0f",
				minP.X, maxP.X, minP.Y, maxP.Y, minP.Z, maxP.Z))
			local c = sumP / nPos
			table.insert(summaryLines, string.format("Tâm trung bình: %s", fmtV(c)))
		end
		local root = getRoot()
		if root then table.insert(summaryLines, "Vị trí bạn lúc quét: " .. fmtV(root.Position)) end
		if workspace.StreamingEnabled then
			table.insert(summaryLines, "⚠ Game bật StreamingEnabled: vật ở xa chưa tải sẽ chưa quét được")
		end
		if capped then
			table.insert(summaryLines, "⚠ Chạm giới hạn " .. SCAN_MAX .. " vật - tăng SCAN_MAX nếu cần quét hết")
		end

		curPage = 1
		applyFilter()
		render()
		drawMarks()
		addLog(summaryLines[1], Enum.MessageType.MessageInfo)
		setStatus("Quét xong: " .. #all .. " vật")
	end

	-- giao diện: mỗi hàng một chức năng
	actionRow(scanCard, 1, "🗺️", "Quét Toàn Bộ Map", "Quét", runScan)

	dropdown(scanCard, 2, "🔎", "Lọc Loại Vật", CATS, "Tất Cả", function(name)
		catFilter = name
		curPage = 1
		refreshSoon()
		setStatus("Lọc: " .. name)
	end)

	slider(scanCard, 3, "📏", "Bán Kính", 0, 2000, 0, function(v)
		radius = v
		curPage = 1
		refreshSoon()
	end)

	scanLabel = textPanel(scanCard, 4)
	scanLabel.Text = esc(SCAN_IDLE)

	actionRow(scanCard, 5, "◀️", "Trang Trước", "◀", function()
		local totalPages = math.max(1, math.ceil(#view / SCAN_PAGE))
		curPage = curPage - 1
		if curPage < 1 then curPage = totalPages end
		render()
	end)

	actionRow(scanCard, 6, "▶️", "Trang Sau", "▶", function()
		local totalPages = math.max(1, math.ceil(#view / SCAN_PAGE))
		curPage = curPage + 1
		if curPage > totalPages then curPage = 1 end
		render()
	end)

	toggle(scanCard, 7, "🏷️", "Hiện Nhãn Vị Trí", false, "Cài Đặt")
	Callbacks["Hiện Nhãn Vị Trí"] = function(on)
		if on then drawMarks() else clearMarks() end
	end

	actionRow(scanCard, 8, "📋", "Sao Chép Kết Quả", "Chép", function()
		copier.run(true)
	end)

	actionRow(scanCard, 9, "⏭️", "Sao Chép Phần Tiếp", "Tiếp", function()
		copier.run(false)
	end)

	actionRow(scanCard, 10, "💾", "Lưu File .txt", "Lưu", function()
		if #all == 0 then
			setStatus("Hãy quét map trước")
			return
		end
		local fname = "VuDong_MapScan_" .. tostring(game.PlaceId) .. ".txt"
		if pcall(writefile, fname, buildReport(math.huge)) then
			setStatus("Đã lưu " .. #view .. " dòng vào file " .. fname)
			addLog("Đã lưu quét map: " .. fname, Enum.MessageType.MessageInfo)
		else
			setStatus("Executor không hỗ trợ writefile - dùng nút Sao Chép")
		end
	end)

	actionRow(scanCard, 11, "🎯", "Chép Vật Gần Nhất", "Chép", function()
		local e = view[1]
		if not e then
			setStatus("Chưa có kết quả - hãy quét map trước")
			return
		end
		copyText(fullLine(1, e), "Đã sao chép vật gần nhất: " .. e.name)
	end)

	actionRow(scanCard, 12, "🖨️", "In Ra Console", "In", function()
		if #view == 0 then
			setStatus("Chưa có kết quả - hãy quét map trước")
			return
		end
		local n = math.min(#view, 300)
		print("=== Vu Dong Script - Quét Map: " .. #view .. " kết quả (in " .. n .. " dòng đầu) ===")
		for i = 1, n do print(fullLine(i, view[i])) end
		setStatus("Đã in " .. n .. " dòng ra console")
	end)

	actionRow(scanCard, 13, "🧹", "Xóa Kết Quả Quét", "Xóa", function()
		table.clear(all)
		table.clear(view)
		table.clear(summaryLines)
		clearMarks()
		curPage = 1
		render()
		setStatus("Đã xóa kết quả quét")
	end)
end -- hết khối Quét Map

----------------------------------------------------------------
-- QUÉT VẬT PHẨM (trang Cài Đặt): tìm & liệt kê các VẬT PHẨM trong game
-- Gồm: vật nhặt được (ProximityPrompt / ClickDetector / chạm TouchInterest), Tool rơi trong map,
-- vật có tên giống vật phẩm (coin, gem, fruit, potion...), đồ đang có trong Túi Đồ, Tool / vật phẩm trong ReplicatedStorage.
-- Muốn thêm / bớt từ khóa: sửa ITEM_WORDS / PICK_WORDS bên dưới (viết thường).
-- Gói trong khối do ... end để không tốn thêm biến local cấp ngoài (Luau giới hạn 200).
-- LƯU Ý: game bật StreamingEnabled thì vật ở xa (chưa tải) chưa quét được - đi lại gần rồi quét lại.
----------------------------------------------------------------
do
	local ITEM_MAX = 20000 -- tối đa số mục ghi nhận mỗi lần quét
	local ITEM_PAGE = 10 -- số mục hiện trong khung mỗi trang
	local ITEM_COPY_MAX = 60000 -- số ký tự tối đa MỖI LẦN chép (chép tiếp bằng nút "Sao Chép Phần Tiếp")
	local ITEM_MARKS = 80 -- số nhãn 3D tối đa (ưu tiên vật gần bạn nhất)
	-- tên chứa từ này (viết thường) = coi là vật phẩm
	local ITEM_WORDS = {
		"coin", "gem", "cash", "money", "gold", "diamond", "crystal", "orb", "fruit", "apple", "egg", "potion",
		"loot", "drop", "item", "pickup", "collect", "reward", "gift", "token", "ticket", "shard", "essence",
		"scroll", "weapon", "sword", "seed", "relic", "rune", "tiền", "vàng", "kim cương", "vật phẩm", "vat pham", "trái", "quả",
	}
	-- chữ trên nút tương tác (ActionText) hoặc tên chứa từ này = nhặt / lấy được
	local PICK_WORDS = { "pick", "collect", "take", "grab", "loot", "claim", "harvest", "gather", "nhặt", "nhat", "lấy", "thu thập", "hái" }
	local ITEM_IGNORE = { "plate", "armor", "armour" } -- tên chứa từ này thì KHÔNG tính là vật phẩm
	local ICATS = { "Tất Cả", "Có Thể Nhặt", "Tool", "Chạm", "Tương Tác Khác", "Theo Tên", "Túi Đồ", "Kho Game" }
	local PRI = { ["Có Thể Nhặt"] = 1, ["Tool"] = 2, ["Chạm"] = 3, ["Tương Tác Khác"] = 4, ["Theo Tên"] = 5 } -- số nhỏ = ưu tiên
	local ITEM_IDLE = 'Chưa quét. Bấm "Quét Vật Phẩm" để tìm: vật nhặt được (Prompt / Click / chạm), Tool rơi trong map, vật có tên giống vật phẩm, đồ trong Túi Đồ và kho game. (Bán Kính 0 = toàn map).'

	local itemCard = card(setCard.Parent, 4, "🎒", "Quét Vật Phẩm", "Tìm vật nhặt được, Tool, vật phẩm trong map & túi đồ", Color3.fromRGB(251, 191, 36))
	rainbowCard(itemCard)

	-- all = mọi mục đã quét, view = sau khi lọc, owners = vật chủ đã ghi nhận (chống trùng), sum = dòng tóm tắt
	local S = { all = {}, view = {}, marks = {}, owners = {}, sum = {}, cat = "Tất Cả", radius = 0, page = 1, busy = false, scanned = false, copyNext = 1, token = 0 }
	local itemLabel -- khung chữ kết quả (tạo ở dưới)

	local function fmtV(v)
		return string.format("%.1f, %.1f, %.1f", v.X, v.Y, v.Z)
	end

	local function getRoot()
		local ch = player.Character
		return ch and ch:FindFirstChild("HumanoidRootPart")
	end

	local function hasWord(s, list, useIgnore)
		if useIgnore then
			for _, bad in ipairs(ITEM_IGNORE) do
				if string.find(s, bad, 1, true) then return false end
			end
		end
		for _, kw in ipairs(list) do
			if string.find(s, kw, 1, true) then return true end
		end
		return false
	end

	-- vị trí của vật chủ
	local function posOf(o)
		local ok, p = pcall(function()
			if o:IsA("BasePart") then return o.Position end
			if o:IsA("Model") then return o:GetPivot().Position end
			if o:IsA("Tool") then
				local h = o:FindFirstChild("Handle")
				if not (h and h:IsA("BasePart")) then h = o:FindFirstChildWhichIsA("BasePart", true) end
				if h then return h.Position end
			end
			return nil
		end)
		if ok then return p end
		return nil
	end

	-- tên hiển thị: "Model/Part" nếu nằm trong model, ngược lại chỉ tên
	local function dispName(o)
		local p = o.Parent
		if p and p ~= workspace and p:IsA("Model") then
			return p.Name .. "/" .. o.Name
		end
		return o.Name
	end

	-- xét một đối tượng trong workspace, nếu là vật phẩm thì ghi vào S.all
	local function consider(inst)
		local cat, owner
		if inst:IsA("ProximityPrompt") or inst:IsA("ClickDetector") or inst:IsA("TouchTransmitter") then
			owner = inst.Parent
			if owner and owner:IsA("Attachment") then owner = owner.Parent end
			if not owner then return end
			if inst:IsA("TouchTransmitter") and not owner:IsA("BasePart") then return end
			if owner.Parent and owner.Parent:IsA("Tool") then owner = owner.Parent end
			if owner.Parent and S.owners[owner.Parent] then owner = owner.Parent end -- phần của vật đã ghi nhận
			local txt = string.lower(owner.Name)
			if owner.Parent and owner.Parent ~= workspace then txt = txt .. " " .. string.lower(owner.Parent.Name) end
			if inst:IsA("ProximityPrompt") then
				txt = txt .. " " .. string.lower(inst.ActionText .. " " .. inst.ObjectText)
			end
			if hasWord(txt, PICK_WORDS, false) or hasWord(txt, ITEM_WORDS, true) then
				cat = "Có Thể Nhặt"
			elseif inst:IsA("TouchTransmitter") then
				cat = "Chạm"
			else
				cat = "Tương Tác Khác"
			end
		elseif inst:IsA("Tool") then
			cat, owner = "Tool", inst
		elseif inst:IsA("Model") or (inst:IsA("BasePart") and not inst:IsA("Terrain")) then
			if S.owners[inst.Parent] then return end -- phần của vật đã ghi nhận
			if inst:IsA("Model") and inst:FindFirstChildOfClass("Humanoid") then return end -- bỏ NPC / người chơi
			if not hasWord(string.lower(inst.Name), ITEM_WORDS, true) then return end
			cat, owner = "Theo Tên", inst
		else
			return
		end

		local old = S.owners[owner]
		if old then
			if PRI[cat] < PRI[old.cat] then
				old.cat, old.inst, old.cls = cat, inst, inst.ClassName
			end
			return
		end
		local e = { inst = inst, owner = owner, name = dispName(owner), cls = inst.ClassName, cat = cat, pos = posOf(owner) }
		S.owners[owner] = e
		table.insert(S.all, e)
	end

	-- thông tin thêm (tính khi cần hiển thị)
	local function extraOf(e)
		local t = {}
		pcall(function()
			local i, o = e.inst, e.owner
			if i:IsA("ProximityPrompt") then
				table.insert(t, string.format("Prompt ActionText=%q ObjectText=%q Hold=%.1fs Tầm=%.0f %s", i.ActionText, i.ObjectText,
					i.HoldDuration, i.MaxActivationDistance, i.Enabled and "Bật" or "Tắt"))
			elseif i:IsA("ClickDetector") then
				table.insert(t, string.format("ClickDetector Tầm=%.0f", i.MaxActivationDistance))
			elseif i:IsA("TouchTransmitter") then
				table.insert(t, "TouchInterest (chạm vào để nhặt / kích hoạt)")
			end
			if o:IsA("Tool") then
				table.insert(t, o:FindFirstChild("Handle") and "có Handle" or "không Handle")
				table.insert(t, o.CanBeDropped and "thả được" or "không thả")
				if o.ToolTip ~= "" then table.insert(t, "ToolTip=" .. o.ToolTip) end
				table.insert(t, "Cha=" .. (o.Parent and o.Parent.Name or "?"))
			elseif o:IsA("BasePart") then
				table.insert(t, "Size " .. fmtV(o.Size))
				table.insert(t, o.Anchored and "Anchored" or "Free")
				if o.Transparency >= 1 then table.insert(t, "vô hình") end
			elseif o:IsA("Model") then
				table.insert(t, #o:GetChildren() .. " con")
			end
		end)
		pcall(function()
			local n = 0
			for k, v in pairs(e.owner:GetAttributes()) do
				n += 1
				if n > 4 then break end
				table.insert(t, k .. "=" .. tostring(v))
			end
		end)
		return table.concat(t, " | ")
	end

	-- một dòng đầy đủ (dùng cho sao chép / lưu file / console)
	local function fullLine(i, e)
		local parts = {
			string.format("#%d [%s] %s | %s", i, e.cat, e.name, e.cls),
			pathOf(e.inst),
			e.pos and string.format("Vector3.new(%.2f, %.2f, %.2f)", e.pos.X, e.pos.Y, e.pos.Z) or "không rõ vị trí",
		}
		if e.dist then table.insert(parts, string.format("cách %.1f stud", e.dist)) end
		local x = extraOf(e)
		if x ~= "" then table.insert(parts, x) end
		return table.concat(parts, " | ")
	end

	local function headerLines()
		local lines = { "=== Vu Dong Script - Quét Vật Phẩm (PlaceId " .. tostring(game.PlaceId) .. ") ===" }
		for _, s in ipairs(S.sum) do table.insert(lines, s) end
		table.insert(lines, string.format("Bộ lọc: %s | Bán kính: %s | %d kết quả", S.cat,
			S.radius > 0 and (S.radius .. " stud") or "toàn map", #S.view))
		table.insert(lines, "--------------------------------------------")
		return lines
	end

	-- báo cáo đầy đủ (dùng cho Lưu File)
	local function buildReport()
		local lines = headerLines()
		for i = 1, #S.view do
			table.insert(lines, fullLine(i, S.view[i]))
			if i % 1500 == 0 then task.wait() end
		end
		return table.concat(lines, "\n")
	end

	-- hiển thị kết quả trong khung chữ
	local function render()
		if not itemLabel then return end
		if not S.scanned then
			itemLabel.Text = esc(ITEM_IDLE)
			return
		end
		local view = S.view
		local hex = theme.accent2:ToHex()
		local out = {}
		for _, s in ipairs(S.sum) do table.insert(out, esc(s)) end
		local totalPages = math.max(1, math.ceil(#view / ITEM_PAGE))
		S.page = math.clamp(S.page, 1, totalPages)
		table.insert(out, string.format('<font color="#%s">── Trang %d/%d · %d kết quả · lọc: %s · bán kính: %s ──</font>',
			hex, S.page, totalPages, #view, esc(S.cat), S.radius > 0 and (S.radius .. " stud") or "toàn map"))
		for i = (S.page - 1) * ITEM_PAGE + 1, math.min(#view, S.page * ITEM_PAGE) do
			local e = view[i]
			local where = e.pos and fmtV(e.pos) or "không rõ vị trí"
			local dist = e.dist and string.format(" · cách %.0f", e.dist) or ""
			table.insert(out, string.format('<font color="#%s">#%d [%s]</font> %s\n      %s%s · %s',
				hex, i, esc(e.cat), esc(e.name), esc(where), dist, esc(e.cls)))
		end
		if #view == 0 then table.insert(out, "(không có vật phẩm nào khớp bộ lọc)") end
		itemLabel.Text = table.concat(out, "\n")
	end

	-- lọc theo loại + bán kính, sắp xếp từ gần đến xa
	local function applyFilter()
		local view = S.view
		table.clear(view)
		S.copyNext = 1
		local root = getRoot()
		local rp = root and root.Position
		for _, e in ipairs(S.all) do
			if S.cat == "Tất Cả" or e.cat == S.cat then
				local d = (rp and e.pos) and (e.pos - rp).Magnitude or nil
				e.dist = d
				if S.radius <= 0 or (d and d <= S.radius) then
					table.insert(view, e)
				end
			end
		end
		table.sort(view, function(a, b)
			local da, db = a.dist or math.huge, b.dist or math.huge
			if da ~= db then return da < db end
			return a.name < b.name
		end)
	end

	-- nhãn 3D trong game: hiện tên + tọa độ trên các vật phẩm gần bạn nhất (xuyên tường)
	local function clearMarks()
		for _, g in ipairs(S.marks) do g:Destroy() end
		table.clear(S.marks)
	end

	local function adorneeOf(o)
		if o:IsA("BasePart") then return o end
		if o:IsA("Model") then return o.PrimaryPart or o:FindFirstChildWhichIsA("BasePart", true) end
		if o:IsA("Tool") then
			local h = o:FindFirstChild("Handle")
			if h and h:IsA("BasePart") then return h end
			return o:FindFirstChildWhichIsA("BasePart", true)
		end
		return nil
	end

	local function drawMarks()
		clearMarks()
		if not State["Hiện Nhãn Vật Phẩm"] then return end
		local gui = player:FindFirstChildOfClass("PlayerGui")
		if not gui then return end
		local n = 0
		for i = 1, #S.view do
			if n >= ITEM_MARKS then break end
			local e = S.view[i]
			if e.pos then
				local ok, part = pcall(adorneeOf, e.owner)
				if ok and part and part:IsDescendantOf(workspace) then
					n += 1
					local bb = Instance.new("BillboardGui")
					bb.Name = "VuDongItemMark"
					bb.Adornee = part
					bb.AlwaysOnTop = true
					bb.ResetOnSpawn = false
					bb.Size = UDim2.fromOffset(220, 46)
					bb.StudsOffset = Vector3.new(0, 2, 0)
					bb.MaxDistance = 2000
					local t = Instance.new("TextLabel")
					t.BackgroundTransparency = 1
					t.Size = UDim2.fromScale(1, 1)
					t.Font = Enum.Font.SourceSansBold
					t.TextSize = 14
					t.TextWrapped = true
					t.TextColor3 = Color3.fromRGB(251, 191, 36)
					t.TextStrokeTransparency = 0
					t.Text = string.format("#%d %s\n%s", i, e.name, fmtV(e.pos))
					t.Parent = bb
					bb.Parent = gui
					table.insert(S.marks, bb)
				end
			end
		end
	end

	-- đổi bộ lọc / bán kính: gom lại, chờ 0.25s rồi mới tính (kéo thanh trượt không bị giật)
	local function refreshSoon()
		S.token += 1
		local my = S.token
		task.delay(0.25, function()
			if my == S.token and S.scanned then
				applyFilter()
				render()
				drawMarks()
			end
		end)
	end

	-- QUÉT VẬT PHẨM
	local function runScan()
		if S.busy then
			setStatus("Đang quét, chờ chút...")
			return
		end
		S.busy = true
		setStatus("Đang quét vật phẩm...")
		local t0 = os.clock()
		table.clear(S.all)
		table.clear(S.owners)

		-- bỏ qua phần thân bên trong nhân vật người chơi (đồ đang cầm đã có ở mục Túi Đồ)
		local skip = {}
		for _, p in ipairs(Players:GetPlayers()) do
			local ch = p.Character
			if ch then
				for _, d in ipairs(ch:GetDescendants()) do skip[d] = true end
			end
		end

		local capped = false
		local ok, err = pcall(function()
			local n = 0
			for _, inst in ipairs(workspace:GetDescendants()) do
				n += 1
				if n % 1500 == 0 then task.wait() end -- nhường khung hình để game không đứng
				if not skip[inst] then
					pcall(consider, inst)
					if #S.all >= ITEM_MAX then
						capped = true
						break
					end
				end
			end

			-- mục không có vị trí trong map: đồ của bạn + kho game
			local function addPlain(o, cat)
				table.insert(S.all, { inst = o, owner = o, name = o.Name, cls = o.ClassName, cat = cat, pos = nil })
			end
			local bp = player:FindFirstChildOfClass("Backpack")
			if bp then
				for _, t in ipairs(bp:GetChildren()) do
					if t:IsA("Tool") then addPlain(t, "Túi Đồ") end
				end
			end
			local ch = player.Character
			if ch then
				for _, t in ipairs(ch:GetChildren()) do
					if t:IsA("Tool") then addPlain(t, "Túi Đồ") end
				end
			end
			local m = 0
			for _, d in ipairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
				m += 1
				if m % 1500 == 0 then task.wait() end
				if #S.all >= ITEM_MAX then
					capped = true
					break
				end
				if d:IsA("Tool") then
					addPlain(d, "Kho Game")
				elseif (d:IsA("Model") or d:IsA("BasePart") or d:IsA("Folder") or d:IsA("ModuleScript"))
					and hasWord(string.lower(d.Name), ITEM_WORDS, true) then
					addPlain(d, "Kho Game")
				end
			end
		end)
		S.busy = false
		table.clear(S.owners)
		if not ok then
			setStatus("Lỗi quét vật phẩm: " .. tostring(err))
			addLog("Lỗi quét vật phẩm: " .. tostring(err), Enum.MessageType.MessageError)
			return
		end

		local counts = {}
		for _, e in ipairs(S.all) do counts[e.cat] = (counts[e.cat] or 0) + 1 end
		table.clear(S.sum)
		table.insert(S.sum, string.format("Đã quét %d vật phẩm (%.1f giây)", #S.all, os.clock() - t0))
		local cs = {}
		for _, name in ipairs(ICATS) do
			if counts[name] then table.insert(cs, name .. " " .. counts[name]) end
		end
		table.insert(S.sum, #cs > 0 and table.concat(cs, " · ") or "(không thấy vật phẩm nào)")
		local root = getRoot()
		if root then table.insert(S.sum, "Vị trí bạn lúc quét: " .. fmtV(root.Position)) end
		if workspace.StreamingEnabled then
			table.insert(S.sum, "⚠ Game bật StreamingEnabled: vật ở xa chưa tải sẽ chưa quét được")
		end
		if capped then
			table.insert(S.sum, "⚠ Chạm giới hạn " .. ITEM_MAX .. " mục - tăng ITEM_MAX nếu cần quét hết")
		end

		S.scanned = true
		S.page = 1
		applyFilter()
		render()
		drawMarks()
		addLog(S.sum[1], Enum.MessageType.MessageInfo)
		setStatus("Quét xong: " .. #S.all .. " vật phẩm")
	end

	-- chép từng phần: mỗi lần tối đa ITEM_COPY_MAX ký tự, bấm "Sao Chép Phần Tiếp" để chép phần sau
	local function copyChunk(reset)
		local view = S.view
		if not S.scanned then
			setStatus("Hãy quét vật phẩm trước")
			return
		end
		if #view == 0 then
			setStatus("Không có kết quả khớp bộ lọc để chép")
			return
		end
		if reset then S.copyNext = 1 end
		local from = S.copyNext
		if from > #view then
			setStatus("Đã chép hết - bấm Sao Chép Kết Quả để chép lại từ đầu")
			return
		end
		local lines, bytes = {}, 0
		if from == 1 then
			lines = headerLines()
			for _, s in ipairs(lines) do bytes += #s + 1 end
		end
		local i = from
		while i <= #view do
			local ln = fullLine(i, view[i])
			if bytes + #ln + 1 > ITEM_COPY_MAX and i > from then break end
			table.insert(lines, ln)
			bytes += #ln + 1
			i += 1
			if i % 1000 == 0 then task.wait() end
		end
		local last = i - 1
		local msg = string.format("Đã chép #%d-#%d / %d%s", from, last, #view,
			last < #view and " - bấm Sao Chép Phần Tiếp để chép tiếp" or " (hết)")
		if copyText(table.concat(lines, "\n"), msg) then
			S.copyNext = last + 1
		end
	end

	-- giao diện: mỗi hàng một chức năng
	actionRow(itemCard, 1, "🎒", "Quét Vật Phẩm", "Quét", runScan)

	dropdown(itemCard, 2, "🔎", "Lọc Loại Vật Phẩm", ICATS, "Tất Cả", function(name)
		S.cat = name
		S.page = 1
		refreshSoon()
		setStatus("Lọc: " .. name)
	end)

	slider(itemCard, 3, "📏", "Bán Kính", 0, 2000, 0, function(v)
		S.radius = v
		S.page = 1
		refreshSoon()
	end)

	itemLabel = textPanel(itemCard, 4)
	itemLabel.Text = esc(ITEM_IDLE)

	actionRow(itemCard, 5, "◀️", "Trang Trước", "◀", function()
		local totalPages = math.max(1, math.ceil(#S.view / ITEM_PAGE))
		S.page = S.page - 1
		if S.page < 1 then S.page = totalPages end
		render()
	end)

	actionRow(itemCard, 6, "▶️", "Trang Sau", "▶", function()
		local totalPages = math.max(1, math.ceil(#S.view / ITEM_PAGE))
		S.page = S.page + 1
		if S.page > totalPages then S.page = 1 end
		render()
	end)

	toggle(itemCard, 7, "🏷️", "Hiện Nhãn Vật Phẩm", false, "Cài Đặt")
	Callbacks["Hiện Nhãn Vật Phẩm"] = function(on)
		if on then drawMarks() else clearMarks() end
	end

	actionRow(itemCard, 8, "📋", "Sao Chép Kết Quả", "Chép", function()
		copyChunk(true)
	end)

	actionRow(itemCard, 9, "⏭️", "Sao Chép Phần Tiếp", "Tiếp", function()
		copyChunk(false)
	end)

	actionRow(itemCard, 10, "💾", "Lưu File .txt", "Lưu", function()
		if not S.scanned then
			setStatus("Hãy quét vật phẩm trước")
			return
		end
		local fname = "VuDong_ItemScan_" .. tostring(game.PlaceId) .. ".txt"
		if pcall(writefile, fname, buildReport()) then
			setStatus("Đã lưu " .. #S.view .. " dòng vào file " .. fname)
			addLog("Đã lưu quét vật phẩm: " .. fname, Enum.MessageType.MessageInfo)
		else
			setStatus("Executor không hỗ trợ writefile - dùng nút Sao Chép")
		end
	end)

	actionRow(itemCard, 11, "🎯", "Chép Vật Phẩm Gần Nhất", "Chép", function()
		local e = S.view[1]
		if not e then
			setStatus("Chưa có kết quả - hãy quét vật phẩm trước")
			return
		end
		copyText(fullLine(1, e), "Đã sao chép vật phẩm gần nhất: " .. e.name)
	end)

	actionRow(itemCard, 12, "🖨️", "In Ra Console", "In", function()
		if #S.view == 0 then
			setStatus("Chưa có kết quả - hãy quét vật phẩm trước")
			return
		end
		local n = math.min(#S.view, 300)
		print("=== Vu Dong Script - Quét Vật Phẩm: " .. #S.view .. " kết quả (in " .. n .. " dòng đầu) ===")
		for i = 1, n do print(fullLine(i, S.view[i])) end
		setStatus("Đã in " .. n .. " dòng ra console")
	end)

