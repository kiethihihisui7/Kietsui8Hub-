			setStatus("Chưa có nhân vật để lưu vị trí")
		end
	end)
	for _, ch in ipairs(plotBtn.Parent:GetChildren()) do
		if ch:IsA("TextLabel") and ch.Text == PLOT_LABEL_TEXT then plotLabel = ch end
	end

	task.spawn(function()
		local env = stash()
