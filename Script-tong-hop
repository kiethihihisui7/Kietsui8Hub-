-- Nút nổi kéo thả có viền cầu vồng RGB để ẩn/hiện menu Rayfield nhanh
local function createFloatingToggle()
    local playerGui = LocalPlayer:WaitForChild("PlayerGui")
    local oldGui = playerGui:FindFirstChild("TkietFloatingToggleGui")
    if oldGui then
        oldGui:Destroy()
    end

    local gui = Instance.new("ScreenGui")
    gui.Name = "TkietFloatingToggleGui"
    gui.ResetOnSpawn = false
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.Parent = playerGui

    local button = Instance.new("TextButton")
    button.Name = "ToggleButton"
    button.Size = UDim2.new(0, 54, 0, 54)
    button.Position = UDim2.new(0.03, 0, 0.35, 0)
    button.BackgroundColor3 = Color3.fromRGB(22, 22, 28)
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.Text = "UI"
    button.Font = Enum.Font.GothamBold
    button.TextSize = 15
    button.AutoButtonColor = true
    button.Parent = gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = button

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 2.5
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = button

    -- Hiệu ứng đổi màu cầu vồng RGB chạy liên tục cho viền nút
    local hue = 0
    local rainbowConn
    rainbowConn = RunService.RenderStepped:Connect(function(dt)
        if not stroke or not stroke.Parent then
            if rainbowConn then
                rainbowConn:Disconnect()
            end
            return
        end
        hue = (hue + dt * 0.35) % 1
        stroke.Color = Color3.fromHSV(hue, 0.9, 1)
    end)

    local menuVisible = true

    local function setRayfieldVisible(state)
        menuVisible = state
        button.Text = menuVisible and "UI" or "Mở"

        -- Tìm ScreenGui của Rayfield trong PlayerGui hoặc CoreGui nếu executor cho phép
        local containers = { playerGui }
        local okCore, coreGui = pcall(function()
            return game:GetService("CoreGui")
        end)
        if okCore and coreGui then
            table.insert(containers, coreGui)
        end

        for _, container in ipairs(containers) do
            for _, child in ipairs(container:GetChildren()) do
                if child ~= gui and (child:IsA("ScreenGui") or child:IsA("Folder")) then
                    if child.Name == "Rayfield" or child:FindFirstChild("Main") then
                        if child:IsA("ScreenGui") then
                            child.Enabled = menuVisible
                        else
                            for _, desc in ipairs(child:GetDescendants()) do
                                if desc:IsA("GuiObject") then
                                    desc.Visible = menuVisible
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    -- Xử lý kéo thả mượt cả cảm ứng và chuột, phân biệt với thao tác bấm (tap/click)
    local dragging = false
    local moved = false
    local dragInput = nil
    local dragStart = Vector2.zero
    local startPos = button.Position

    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            moved = false
            dragInput = input
            dragStart = input.Position
            startPos = button.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    if dragInput == input then
                        dragInput = nil
                    end
                end
            end)
        end
    end)

    button.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input == dragInput then
            local delta = input.Position - dragStart
            if delta.Magnitude > 6 then
                moved = true
            end
            button.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)

    button.Activated:Connect(function()
        if not moved then
            setRayfieldVisible(not menuVisible)
        end
    end)
end

createFloatingToggle()

local function runRemoteScript(name, url, bypassCache, beforeRun)
    local success, err = pcall(function()
        if type(beforeRun) == "function" then
            beforeRun()
        end
        local source = bypassCache and game:HttpGet(url, true) or game:HttpGet(url)
        local fn = loadstring(source)
        if type(fn) ~= "function" then
            error("Invalid Lua chunk returned from URL")
        end
        return fn()
    end)

    if success then
        Rayfield:Notify({
            Title = "Executed",
            Content = name .. " loaded successfully.",
            Duration = 4
        })
    else
        warn("[" .. name .. "] Failed:", err)
        Rayfield:Notify({
            Title = "Load Error",
            Content = "Failed to load " .. name .. ". Check console (F9).",
            Duration = 5
        })
    end
end

